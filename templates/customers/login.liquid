<div class="page-hero container">
  <h1 class="page-hero__title">{{ 'customer.login.title' | t }}</h1>
</div>
<div class="section container">
  <div style="max-width:460px;margin-inline:auto;">
    <div id="login">
      {%- form 'customer_login', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<p class="form-note form-note--error" style="margin-bottom:16px;">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="field">
          <label for="cl-email">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="cl-email" name="customer[email]" autocomplete="email" required>
        </div>
        {%- if form.password_needed -%}
          <div class="field">
            <label for="cl-password">{{ 'customer.login.password' | t }}</label>
            <input type="password" id="cl-password" name="customer[password]" autocomplete="current-password" required>
          </div>
        {%- endif -%}
        <button type="submit" class="btn btn--block btn--lg">{{ 'customer.login.sign_in' | t }}</button>
        <p class="text-center mt-24" style="font-size:14px;color:var(--muted);">
          <a class="link-underline" style="text-transform:none;letter-spacing:0;" href="#recover">{{ 'customer.login.forgot' | t }}</a>
          &nbsp;·&nbsp;
          <a class="link-underline" style="text-transform:none;letter-spacing:0;" href="{{ routes.account_register_url }}">{{ 'customer.login.create' | t }}</a>
        </p>
      {%- endform -%}
    </div>

    <div id="recover" style="display:none;margin-top:8px;">
      <h2 style="font-size:var(--fs-h3);margin-bottom:12px;">{{ 'customer.recover.title' | t }}</h2>
      <p style="color:var(--muted);margin-bottom:16px;">{{ 'customer.recover.body' | t }}</p>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}<p class="form-note form-note--success" style="margin-bottom:16px;">{{ 'customer.recover.success' | t }}</p>{%- endif -%}
        <div class="field">
          <label for="recover-email">{{ 'customer.login.email' | t }}</label>
          <input type="email" id="recover-email" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="btn btn--block">{{ 'customer.recover.submit' | t }}</button>
        <p class="text-center mt-24"><a class="link-underline" style="text-transform:none;letter-spacing:0;" href="#login">{{ 'customer.recover.cancel' | t }}</a></p>
      {%- endform -%}
    </div>
  </div>
</div>
<script>
  (function(){
    function show(hash){
      var login=document.getElementById('login'),recover=document.getElementById('recover');
      if(hash==='#recover'){login.style.display='none';recover.style.display='block';}
      else{login.style.display='block';recover.style.display='none';}
    }
    document.addEventListener('click',function(e){var a=e.target.closest('a[href="#recover"],a[href="#login"]');if(a){e.preventDefault();show(a.getAttribute('href'));}});
    if(location.hash==='#recover'){show('#recover');}
  })();
</script>
