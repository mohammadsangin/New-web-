<section class="container" style="padding: 160px 0 80px;">
  <div style="max-width: 460px; margin: 0 auto;">
    <p class="eyebrow section-header__eyebrow">Account</p>
    <h1 class="page-hero__title italic-em" style="font-size: clamp(32px,4vw,48px);">Sign in</h1>
    {%- form 'customer_login', class: 'liquid-glass-soft', style: 'margin-top: 32px; padding: 28px; border-radius: 24px;' -%}
      {%- if form.errors -%}
        <div style="margin-bottom: 16px; color: var(--color-danger); font-size: 14px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <label class="label" for="customer-email">Email</label>
      <input class="input" type="email" name="customer[email]" id="customer-email" autocomplete="email" required>
      <div style="margin-top: 16px;">
        <label class="label" for="customer-password">Password</label>
        <input class="input" type="password" name="customer[password]" id="customer-password" autocomplete="current-password" required>
      </div>
      <button class="btn btn--primary btn--lg" type="submit" style="margin-top: 20px; width: 100%;">Sign in</button>
      <p style="margin-top: 16px; font-size: 12px; color: var(--color-cream-faint); text-align: center;">
        <a href="{{ routes.account_recover_url }}">Forgot password?</a> ·
        <a href="{{ routes.account_register_url }}">Create account</a>
      </p>
    {%- endform -%}
  </div>
</section>
