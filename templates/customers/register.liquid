<div class="page-hero container">
  <h1 class="page-hero__title">{{ 'customer.register.title' | t }}</h1>
</div>
<div class="section container">
  <div style="max-width:460px;margin-inline:auto;">
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<p class="form-note form-note--error" style="margin-bottom:16px;">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label for="rg-first">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="rg-first" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="rg-last">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="rg-last" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="rg-email">{{ 'customer.login.email' | t }}</label>
        <input type="email" id="rg-email" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="field">
        <label for="rg-password">{{ 'customer.login.password' | t }}</label>
        <input type="password" id="rg-password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--block btn--lg">{{ 'customer.register.submit' | t }}</button>
      <p class="text-center mt-24"><a class="link-underline" style="text-transform:none;letter-spacing:0;" href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a></p>
    {%- endform -%}
  </div>
</div>
