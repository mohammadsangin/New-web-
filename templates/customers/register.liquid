<section class="container" style="padding: 160px 0 80px;">
  <div style="max-width: 460px; margin: 0 auto;">
    <p class="eyebrow section-header__eyebrow">Account</p>
    <h1 class="page-hero__title italic-em" style="font-size: clamp(32px,4vw,48px);">Create an account</h1>
    {%- form 'create_customer', class: 'liquid-glass-soft', style: 'margin-top: 32px; padding: 28px; border-radius: 24px;' -%}
      {%- if form.errors -%}
        <div style="margin-bottom: 16px; color: var(--color-danger); font-size: 14px;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
        <div>
          <label class="label" for="first">First name</label>
          <input class="input" type="text" name="customer[first_name]" id="first" autocomplete="given-name">
        </div>
        <div>
          <label class="label" for="last">Last name</label>
          <input class="input" type="text" name="customer[last_name]" id="last" autocomplete="family-name">
        </div>
      </div>
      <div style="margin-top: 16px;">
        <label class="label" for="reg-email">Email</label>
        <input class="input" type="email" name="customer[email]" id="reg-email" required>
      </div>
      <div style="margin-top: 16px;">
        <label class="label" for="reg-password">Password</label>
        <input class="input" type="password" name="customer[password]" id="reg-password" required>
      </div>
      <button class="btn btn--primary btn--lg" type="submit" style="margin-top: 20px; width: 100%;">Create account</button>
    {%- endform -%}
  </div>
</section>
