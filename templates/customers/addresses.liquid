<div class="page-hero container">
  <h1 class="page-hero__title">{{ 'customer.addresses.title' | t }}</h1>
</div>
<div class="section container">
  <div style="max-width:640px;margin-inline:auto;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
      <a class="link-underline" style="text-transform:none;letter-spacing:0;" href="{{ routes.account_url }}">{{ 'customer.order.back' | t }}</a>
      <button type="button" class="btn" data-addr-toggle="new">{{ 'customer.addresses.add' | t }}</button>
    </div>

    <div id="addr-new" style="display:none;border:1px solid var(--hairline);border-radius:var(--radius-lg);padding:24px;margin-bottom:28px;">
      {%- form 'customer_address', customer.new_address -%}
        <div class="field"><label>{{ 'customer.addresses.first_name' | t }}</label><input type="text" name="address[first_name]" autocomplete="given-name"></div>
        <div class="field"><label>{{ 'customer.addresses.last_name' | t }}</label><input type="text" name="address[last_name]" autocomplete="family-name"></div>
        <div class="field"><label>{{ 'customer.addresses.address1' | t }}</label><input type="text" name="address[address1]" autocomplete="address-line1"></div>
        <div class="field"><label>{{ 'customer.addresses.address2' | t }}</label><input type="text" name="address[address2]" autocomplete="address-line2"></div>
        <div class="field"><label>{{ 'customer.addresses.city' | t }}</label><input type="text" name="address[city]" autocomplete="address-level2"></div>
        <div class="field"><label>{{ 'customer.addresses.zip' | t }}</label><input type="text" name="address[zip]" autocomplete="postal-code"></div>
        <div class="field"><label>{{ 'customer.addresses.country' | t }}</label>{{ all_country_option_tags }}</div>
        <button type="submit" class="btn">{{ 'customer.addresses.save' | t }}</button>
        <button type="button" class="btn btn--secondary" data-addr-toggle="new" style="margin-left:8px;">{{ 'customer.recover.cancel' | t }}</button>
      {%- endform -%}
    </div>

    {%- for address in customer.addresses -%}
      <div style="border:1px solid var(--hairline);border-radius:var(--radius);padding:20px;margin-bottom:16px;">
        {%- if address == customer.default_address -%}<p style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--brass-deep);font-weight:600;margin-bottom:8px;">{{ 'customer.addresses.default' | t }}</p>{%- endif -%}
        <div style="color:var(--muted);font-size:14px;">{{ address | format_address }}</div>
      </div>
    {%- endfor -%}
  </div>
</div>
<script>
  document.addEventListener('click',function(e){var b=e.target.closest('[data-addr-toggle]');if(!b)return;var el=document.getElementById('addr-'+b.getAttribute('data-addr-toggle'));if(el)el.style.display=el.style.display==='none'?'block':'none';});
</script>
