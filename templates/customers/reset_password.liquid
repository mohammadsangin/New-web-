<section class="container" style="padding: 160px 0 80px;">
  <div style="max-width: 460px; margin: 0 auto;">
    <h1 class="page-hero__title italic-em" style="font-size: clamp(28px,3.5vw,42px);">Reset password</h1>
    {%- form 'reset_customer_password', class: 'liquid-glass-soft', style: 'margin-top: 32px; padding: 28px; border-radius: 24px;' -%}
      {%- if form.errors -%}
        <div style="margin-bottom: 16px; color: var(--color-danger); font-size: 14px;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <label class="label" for="rp-password">New password</label>
      <input class="input" type="password" name="customer[password]" id="rp-password" required>
      <div style="margin-top: 16px;">
        <label class="label" for="rp-confirm">Confirm password</label>
        <input class="input" type="password" name="customer[password_confirmation]" id="rp-confirm" required>
      </div>
      <button class="btn btn--primary btn--lg" type="submit" style="margin-top: 20px; width: 100%;">Reset password</button>
    {%- endform -%}
  </div>
</section>
