<div class="page-hero container">
  <h1 class="page-hero__title">{{ 'customer.reset.title' | t }}</h1>
</div>
<div class="section container">
  <div style="max-width:420px;margin-inline:auto;">
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<p class="form-note form-note--error" style="margin-bottom:16px;">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="field">
        <label for="rp-password">{{ 'customer.reset.password' | t }}</label>
        <input type="password" id="rp-password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="rp-confirm">{{ 'customer.reset.confirm' | t }}</label>
        <input type="password" id="rp-confirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn btn--block btn--lg">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
