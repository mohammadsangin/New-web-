{%- layout 'password' -%}
<div style="min-height:100vh;display:grid;place-items:center;padding:var(--gutter);text-align:center;background:var(--dark);color:var(--on-dark);">
  <div style="max-width:520px;">
    {%- if settings.logo != blank -%}
      {%- assign pw_logo_h = 160 | times: settings.logo.height | divided_by: settings.logo.width -%}
      <img src="{{ settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="160" height="{{ pw_logo_h }}" style="width:160px;height:auto;margin:0 auto 24px;filter:brightness(0) invert(1);">
    {%- else -%}
      <p class="footer__brand-name" style="color:var(--on-dark);">{{ shop.name | default: 'KYMRA' }}</p>
    {%- endif -%}
    <p class="eyebrow eyebrow--center eyebrow--on-dark">{{ 'general.password.coming_soon' | t }}</p>
    <h1 style="color:#fff;font-size:var(--fs-h1);margin-bottom:16px;">{{ page_title }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="rte" style="color:rgba(233,227,214,.8);margin-bottom:28px;">{{ shop.password_message }}</div>
    {%- else -%}
      <p style="color:rgba(233,227,214,.8);margin-bottom:28px;">{{ 'general.password.message' | t }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter-form', style: 'margin:0 auto;' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <label class="visually-hidden" for="pw-email">{{ 'newsletter.email' | t }}</label>
      <input id="pw-email" type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required autocomplete="email">
      <button type="submit">{% render 'icon', name: 'arrow-right' %}</button>
      {%- if form.posted_successfully? -%}<p class="form-note form-note--success" style="flex-basis:100%;">{{ 'newsletter.success' | t }}</p>{%- endif -%}
    {%- endform -%}

    <div style="margin-top:40px;">
      <button type="button" class="link-underline link-underline--on-dark" data-drawer-open="pw-login" style="background:none;border:0;">{{ 'general.password.enter_password' | t }}</button>
    </div>
  </div>
</div>

<div class="drawer drawer--right" id="pw-login" role="dialog" aria-modal="true" aria-hidden="true">
  <div class="drawer__header">
    <span class="drawer__title">{{ 'general.password.enter_store' | t }}</span>
    <button class="drawer__close" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}" data-drawer-focus>{% render 'icon', name: 'close' %}</button>
  </div>
  <div class="drawer__body" style="padding:24px var(--gutter);">
    {%- form 'storefront_password' -%}
      <div class="field">
        <label for="store-password">{{ 'general.password.password_label' | t }}</label>
        <input type="password" id="store-password" name="password" autocomplete="current-password">
      </div>
      {%- if form.errors -%}<p class="form-note form-note--error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>{%- endif -%}
      <button type="submit" class="btn btn--block btn--lg">{{ 'general.password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>
<script src="{{ 'theme.js' | asset_url }}" defer></script>
