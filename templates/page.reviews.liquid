{%- comment -%}
  Reviews page — branded intro + the theme-native "Reviews carousel" section.
  No review app: testimonials are added as Review blocks on this section in the
  theme editor (Customize → Reviews page → Reviews carousel → Add block). The
  section renders nothing on the live storefront until at least one review with
  a quote is added, so there is no spinner and no external dependency.
{%- endcomment -%}
{%- style -%}
  #reviews-page .reviews__intro { max-width: 60ch; margin-inline: auto; color: var(--muted, #6A6459); font-size: 17px; line-height: 1.7; text-align: center; }
{%- endstyle -%}

<div id="reviews-page">
  <div class="page-hero container">
    <p class="eyebrow eyebrow--center">Kind words</p>
    <h1 class="page-hero__title">Reviews</h1>
    <p class="reviews__intro">What our customers say about their pieces — genuine words from people living with Kymra lighting.</p>
  </div>

  {%- if page.content != blank -%}
    <div class="section container">
      <div class="rte" style="max-width:760px;margin-inline:auto;">{{ page.content }}</div>
    </div>
  {%- endif -%}

  {% section 'reviews-carousel' %}
</div>
