{%- comment -%} Main product (PDP). Editor-ordered blocks in the info column. {%- endcomment -%}
{%- liquid
  assign product = product
  assign current = product.selected_or_first_available_variant
  assign media = product.media
-%}
<section class="pdp" data-product>
  <div class="container">

    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        {%- if product.collections.size > 0 -%}
          {%- assign col = product.collections.first -%}
          <li><span class="breadcrumb__sep">/</span> <a href="{{ col.url }}">{{ col.title }}</a></li>
        {%- endif -%}
        <li><span class="breadcrumb__sep">/</span> <span aria-current="page">{{ product.title }}</span></li>
      </ol>
    </nav>

    <div class="pdp__grid">
      {%- comment -%} ===== Gallery: sticky on desktop; thumb-switch + swipeable on mobile ===== {%- endcomment -%}
      <div class="gallery gallery--sticky">
        {%- if media.size > 1 -%}
          <div class="gallery__thumbs" role="tablist" aria-label="{{ 'products.product.gallery_thumbnails' | t }}">
            {%- for m in media -%}
              <button class="gallery__thumb" type="button" data-gallery-thumb="{{ forloop.index0 }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}">
                <span class="media ratio-square">
                  <img src="{{ m.preview_image | image_url: width: 160 }}" alt="" width="66" height="66" loading="lazy" decoding="async">
                </span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="gallery__main" data-gallery-main>
          {%- if media.size > 0 -%}
            {%- for m in media -%}
              <div class="gallery__slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide="{{ forloop.index0 }}">
                <div class="media ratio-square">
                  <img
                    src="{{ m.preview_image | image_url: width: 1000 }}"
                    srcset="{{ m.preview_image | image_url: width: 500 }} 500w, {{ m.preview_image | image_url: width: 800 }} 800w, {{ m.preview_image | image_url: width: 1000 }} 1000w, {{ m.preview_image | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 900px) 55vw, 100vw"
                    alt="{{ m.preview_image.alt | escape }}"
                    width="{{ m.preview_image.width }}" height="{{ m.preview_image.height }}"
                    {% if forloop.first %}fetchpriority="high" loading="eager"{% else %}loading="lazy"{% endif %} decoding="async">
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="media ratio-square">{% render 'placeholder' %}</div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== Info column: buy panel + description + accordions (right) ===== {%- endcomment -%}
      <div class="pdp-info">
        {%- form 'product', product, data-product-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current.id }}">

          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <p class="pdp-info__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="pdp-info__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

              {%- when 'price' -%}
                <div class="pdp-info__price" data-price-mount {{ block.shopify_attributes }}>
                  {% render 'price', product: product, variant: current %}
                </div>

              {%- when 'lede' -%}
                {%- if block.settings.text != blank -%}
                  <p class="pdp-info__desc-lede" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
                {%- elsif product.metafields.custom.lede -%}
                  <p class="pdp-info__desc-lede" {{ block.shopify_attributes }}>{{ product.metafields.custom.lede }}</p>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      <div class="variant-group" data-option-index="{{ forloop.index0 }}">
                        <span class="variant-group__label">{{ option.name }}<span data-selected-value>{{ option.selected_value }}</span></span>
                        <div class="variant-options">
                          {%- for value in option.values -%}
                            {%- liquid
                              assign input_id = 'opt-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0
                              assign is_checked = false
                              if option.selected_value == value
                                assign is_checked = true
                              endif
                            -%}
                            <div class="variant-option">
                              <input type="radio" id="{{ input_id }}" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if is_checked %} checked{% endif %}>
                              <label for="{{ input_id }}">{{ value }}</label>
                            </div>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

              {%- when 'buy_buttons' -%}
                <div data-buy-anchor {{ block.shopify_attributes }}>
                  <div class="pdp-buy">
                    <div class="qty">
                      <button type="button" data-qty-step="-1" aria-label="{{ 'cart.general.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                      <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'cart.general.quantity' | t }}">
                      <button type="button" data-qty-step="1" aria-label="{{ 'cart.general.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                    <button type="submit" class="btn btn--lg"{% unless current.available %} aria-disabled="true"{% endunless %}>
                      <span data-add-label>{% if current.available %}{{ 'products.product.add_to_bag' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
                    </button>
                  </div>
                </div>

              {%- when 'trust' -%}
                <div class="pdp-trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.line_1 != blank -%}
                    <p class="pdp-trust__item">{% render 'icon', name: 'truck' %} <span>{{ block.settings.line_1 }}</span></p>
                  {%- endif -%}
                  {%- if block.settings.line_2 != blank -%}
                    <p class="pdp-trust__item">{% render 'icon', name: 'refresh' %} <span>{{ block.settings.line_2 }}</span></p>
                  {%- endif -%}
                  {%- if block.settings.line_3 != blank -%}
                    <p class="pdp-trust__item">{% render 'icon', name: 'clock' %} <span>{{ block.settings.line_3 }}</span></p>
                  {%- endif -%}
                </div>

              {%- when 'bulbs' -%}
                {%- comment -%}
                  "You'll need a bulb" module — OPTIONAL, per-product, driven by
                  PRODUCT METAFIELDS (no code needed to configure). It renders
                  NOTHING unless the product links a compatible bulb.

                  Canonical, locked metafield keys (Settings → Custom data →
                  Products → Add definition):
                    • custom.compatible_bulb
                      type: "Product" (single product_reference) — the bulb this
                      fitting takes.
                    • custom.bulb_quantity
                      type: "Integer" (number_integer) — how many the fitting needs;
                      becomes the default quantity in the stepper (falls back to 1).
                  Then, on each product, link the bulb product and set the count.
                {%- endcomment -%}
                {%- if block.settings.show_bulbs -%}
                  {%- liquid
                    assign bulb = product.metafields.custom.compatible_bulb.value
                    assign required = product.metafields.custom.bulb_quantity.value | default: 1
                    if required < 1
                      assign required = 1
                    endif
                  -%}
                  {%- if bulb != blank -%}
                    {%- assign bv = bulb.selected_or_first_available_variant -%}
                    <div class="pdp-bulbs" data-bulbs {{ block.shopify_attributes }}>
                      {%- if block.settings.eyebrow != blank -%}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
                      {%- if block.settings.heading != blank -%}<p class="pdp-bulbs__head">{{ block.settings.heading | escape }}</p>{%- endif -%}
                      <div class="pdp-bulbs__list">
                        <div class="bulb-card">
                          <a class="bulb-card__media media ratio-square" href="{{ bulb.url }}" tabindex="-1" aria-hidden="true">
                            {%- if bulb.featured_media -%}
                              <img src="{{ bulb.featured_media | image_url: width: 120 }}" srcset="{{ bulb.featured_media | image_url: width: 120 }} 1x, {{ bulb.featured_media | image_url: width: 240 }} 2x" alt="" width="60" height="60" loading="lazy" decoding="async">
                            {%- else -%}
                              {% render 'placeholder' %}
                            {%- endif -%}
                          </a>
                          <div class="bulb-card__info">
                            <a class="bulb-card__title" href="{{ bulb.url }}">{{ bulb.title }}</a>
                            <span class="bulb-card__price">{% render 'price', product: bulb %}</span>
                          </div>
                          {%- if bv and bv.available -%}
                            <div class="bulb-card__buy">
                              <div class="qty qty--sm">
                                <button type="button" data-qty-step="-1" aria-label="{{ 'cart.general.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                                <input type="number" value="{{ required }}" min="1" inputmode="numeric" data-quick-qty aria-label="{{ 'cart.general.quantity' | t }} — {{ bulb.title | escape }}">
                                <button type="button" data-qty-step="1" aria-label="{{ 'cart.general.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                              </div>
                              <button type="button" class="btn btn--secondary bulb-card__add" data-cart-add="{{ bv.id }}" aria-label="{{ 'cart.general.add_product' | t: title: bulb.title }}">{{ 'products.product.add_bulb' | t }}</button>
                            </div>
                          {%- else -%}
                            <span class="bulb-card__soldout">{{ 'products.card.sold_out' | t }}</span>
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        {%- endform -%}

        {%- comment -%}
          ===== Editorial description + accordions — in the RIGHT column =====
          One exclusive accordion group beside the gallery. The description is
          its own collapsible "Overview" row; opening one closes the others
          (see initAccordions in theme.js). Native <details>, closed by default;
          degrade gracefully with JS off (independent, just not exclusive).
        {%- endcomment -%}
        {%- assign has_details = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'description' and product.description != blank -%}{%- assign has_details = true -%}{%- endif -%}
          {%- if block.type == 'accordions' -%}
            {%- if block.settings.details != blank or block.settings.dimensions != blank or block.settings.delivery != blank -%}{%- assign has_details = true -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if has_details -%}
          <div class="pdp__details">
            <div class="accordions" data-accordion-group>
              {%- for block in section.blocks -%}
                {%- case block.type -%}
                  {%- when 'description' -%}
                    {%- if product.description != blank -%}
                      <details class="accordion" {{ block.shopify_attributes }}>
                        <summary class="accordion__summary">{{ block.settings.title | default: 'Overview' | escape }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
                        <div class="accordion__body rte">{{ product.description }}</div>
                      </details>
                    {%- endif -%}
                  {%- when 'accordions' -%}
                    {%- if block.settings.details != blank -%}
                      <details class="accordion" {{ block.shopify_attributes }}>
                        <summary class="accordion__summary">{{ block.settings.details_title | default: 'Details' | escape }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
                        <div class="accordion__body rte">{{ block.settings.details }}</div>
                      </details>
                    {%- endif -%}
                    {%- if block.settings.dimensions != blank -%}
                      <details class="accordion" {{ block.shopify_attributes }}>
                        <summary class="accordion__summary">{{ block.settings.dimensions_title | default: 'Dimensions' | escape }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
                        <div class="accordion__body rte">{{ block.settings.dimensions }}</div>
                      </details>
                    {%- endif -%}
                    {%- if block.settings.delivery != blank -%}
                      <details class="accordion" {{ block.shopify_attributes }}>
                        <summary class="accordion__summary">{{ block.settings.delivery_title | default: 'Delivery & returns' | escape }}<span class="accordion__icon">{% render 'icon', name: 'plus' %}</span></summary>
                        <div class="accordion__body rte">{{ block.settings.delivery }}</div>
                      </details>
                    {%- endif -%}
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Variant data for JS {%- endcomment -%}
  <script type="application/json" data-product-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "available": {{ variant.available }},
          "options": {{ variant.options | json }},
          "price_html": {% capture ph %}{% render 'price', product: product, variant: variant %}{% endcapture %}{{ ph | strip_newlines | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</section>

{%- comment -%} ===== Recommended for you ===== {%- endcomment -%}
{%- if section.settings.show_complete_look -%}
  {%- assign look = product.collections.first -%}
  {%- if look and look.products.size > 1 -%}
    <section class="complete">
      <div class="container">
        <div class="row-head reveal">
          <div class="row-head__text">
            <p class="eyebrow">{{ 'products.product.complete_look_eyebrow' | t }}</p>
            <h2 class="section-head__title">{{ 'products.product.complete_look' | t }}</h2>
          </div>
          <a class="row-head__link link-underline" href="{{ look.url }}">{{ 'products.product.view_collection' | t }}</a>
        </div>
        <div class="product-grid product-grid--4">
          {%- assign shown = 0 -%}
          {%- for p in look.products limit: 8 -%}
            {%- if p.id != product.id and shown < 4 -%}
              {% render 'product-card', product: p %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
{%- endif -%}

{%- comment -%} ===== Sticky mini add-to-bag ===== {%- endcomment -%}
<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div class="sticky-buy__inner container">
    {%- if product.featured_media -%}
      <div class="sticky-buy__media"><img src="{{ product.featured_media | image_url: width: 100 }}" alt="" width="46" height="46" loading="lazy"></div>
    {%- endif -%}
    <div class="sticky-buy__text">
      <p class="sticky-buy__title">{{ product.title }}</p>
      <p class="sticky-buy__price" data-sticky-price>{% render 'price', product: product, variant: current %}</p>
    </div>
    <button type="button" class="btn" data-sticky-add>{{ 'products.product.add_to_bag' | t }}</button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "checkbox", "id": "show_complete_look", "label": "Show 'Recommended for you'", "default": true }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "lede", "name": "Short intro", "limit": 1,
      "settings": [ { "type": "textarea", "id": "text", "label": "Intro text", "info": "Falls back to the custom.lede metafield if empty." } ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "buy_buttons", "name": "Quantity + Add to bag", "limit": 1 },
    {
      "type": "trust", "name": "Trust line", "limit": 1,
      "settings": [
        { "type": "text", "id": "line_1", "label": "Line 1", "default": "Free UK delivery over £300" },
        { "type": "text", "id": "line_2", "label": "Line 2", "default": "30-day returns" },
        { "type": "text", "id": "line_3", "label": "Line 3", "default": "Made to order — allow 3–4 weeks" }
      ]
    },
    {
      "type": "bulbs", "name": "Compatible bulb", "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Optional. Shows the bulb a fitting needs so customers can add it. It appears only when the product links a compatible bulb via a metafield — nothing shows otherwise." },
        { "type": "paragraph", "content": "Setup once in Settings → Custom data → Products. Add a metafield 'custom.compatible_bulb' of type 'Product' (single product reference), and 'custom.bulb_quantity' of type 'Integer'. Then, on each fitting, link the bulb product and set the quantity." },
        { "type": "checkbox", "id": "show_bulbs", "label": "Show module", "default": true },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bulb sold separately" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "You'll need a bulb" }
      ]
    },
    {
      "type": "description", "name": "Description", "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Row title", "default": "Overview" }
      ]
    },
    {
      "type": "accordions", "name": "Accordions", "limit": 1,
      "settings": [
        { "type": "text", "id": "details_title", "label": "Details title", "default": "Details" },
        { "type": "richtext", "id": "details", "label": "Details content" },
        { "type": "text", "id": "dimensions_title", "label": "Dimensions title", "default": "Dimensions" },
        { "type": "richtext", "id": "dimensions", "label": "Dimensions content" },
        { "type": "text", "id": "delivery_title", "label": "Delivery title", "default": "Delivery & returns" },
        { "type": "richtext", "id": "delivery", "label": "Delivery content" }
      ]
    }
  ]
}
{% endschema %}
