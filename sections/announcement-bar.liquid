{%- comment -%} Slim rotating announcement bar — honest messaging only. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="announcement" data-announcement data-rotate="{{ section.settings.rotate_speed | times: 1000 }}">
    <div class="announcement__viewport container">
      <div class="announcement__track">
        {%- for block in section.blocks -%}
          <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span>{{ block.settings.text | escape }}</span>
            {%- endif -%}
          </p>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on orders over £300" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free UK delivery on orders over £300" } },
      { "type": "message", "settings": { "text": "Made to order — allow 3–4 weeks for your piece" } },
      { "type": "message", "settings": { "text": "Expert advice — 0333 090 0045" } }
    ]
  }
}
{% endschema %}
