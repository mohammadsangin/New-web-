{%- comment -%}
  Slim announcement bar — honest messaging only. Messages auto-rotate on a slow
  interval with a subtle vertical slide/fade; optional < > arrows step manually.
  Auto-rotate pauses on hover/focus and is disabled under prefers-reduced-motion
  (single static message, arrows still work). Fixed height — no layout shift.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  {%- assign multi = false -%}
  {%- if section.blocks.size > 1 -%}{%- assign multi = true -%}{%- endif -%}
  {%- assign show_arrows = false -%}
  {%- if section.settings.show_arrows and multi -%}{%- assign show_arrows = true -%}{%- endif -%}
  <div class="announcement" data-announcement data-interval="{{ section.settings.rotate_speed | times: 1000 }}">
    <div class="announcement__bar container">
      {%- if show_arrows -%}
        <button class="announcement__arrow" type="button" data-ann-prev aria-label="{{ 'general.announcement.previous' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
      {%- endif -%}

      <div class="announcement__viewport" aria-live="polite" aria-atomic="true">
        <ul class="announcement__track" role="list">
          {%- for block in section.blocks -%}
            <li class="announcement__item{% if forloop.first %} is-active{% endif %}" data-ann-item {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
              {%- else -%}
                <span>{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if show_arrows -%}
        <button class="announcement__arrow" type="button" data-ann-next aria-label="{{ 'general.announcement.next' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 5,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Rotation speed",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrow controls",
      "info": "Left/right arrows to step messages. Hidden when there is only one message.",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery on orders over £300" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Free UK delivery on orders over £300" } },
      { "type": "message", "settings": { "text": "Made to order — allow 3–4 weeks for your piece" } },
      { "type": "message", "settings": { "text": "Expert advice — 0333 090 0045" } }
    ]
  }
}
{% endschema %}
