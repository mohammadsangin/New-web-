{%- comment -%} Hero — full-bleed. LCP image, not lazy. {%- endcomment -%}
{%- liquid
  assign align = section.settings.alignment
-%}
<section class="hero hero--{{ align }}">
  <div class="hero__media">
    <div class="media ratio-hero">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w, {{ section.settings.image | image_url: width: 2600 }} 2600w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
          fetchpriority="high" loading="eager" decoding="async">
      {%- else -%}
        <div class="media-placeholder">{% render 'icon', name: 'image' %}</div>
      {%- endif -%}
    </div>
    <div class="hero__scrim"></div>
    <div class="hero__content">
      <div class="hero__inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow hero__eyebrow{% if align == 'center' %} eyebrow--center{% endif %}">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="hero__title">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hero__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        <div class="hero__ctas">
          {%- if section.settings.cta_label != blank -%}
            <a class="btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
          {%- endif -%}
          {%- if section.settings.cta2_label != blank -%}
            <a class="btn btn--ghost-dark" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "21:9 desktop, 4:5 mobile. Calm lit interior or brass fixture." },
    {
      "type": "select", "id": "alignment", "label": "Content alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Solid brass, made to order" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Lighting with a considered hand" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Period and Art Deco fixtures, cast in solid brass and finished for interiors that last." },
    { "type": "text", "id": "cta_label", "label": "Primary button label", "default": "Explore the collection" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
