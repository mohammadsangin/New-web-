{%- comment -%}
  Header: sticky, three zones. Logo hard LEFT · primary nav CENTRED · utility
  icons (search, account, cart) hard RIGHT on desktop. On mobile: hamburger
  left, logo centred, cart right. Single logo element repositioned via CSS grid
  areas (no duplicate markup, no CLS).
  Mega menu auto-selects: image-tile layout when a top-level item has >=2 image
  blocks; grouped columns when it has 3-level nesting; simple columns otherwise.
{%- endcomment -%}
{%- liquid
  assign menu = linklists[section.settings.menu]
  assign logo_image = section.settings.logo | default: settings.logo
-%}
<div class="header">
  <div class="header__inner container">
    <button class="header__icon header__menu-toggle" type="button"
      data-drawer-open="menu-drawer" aria-label="{{ 'accessibility.open_menu' | t }}" aria-controls="menu-drawer" aria-expanded="false">
      {% render 'icon', name: 'menu' %}
    </button>

    <a class="header__brand{% unless logo_image %} header__brand--text{% endunless %}" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
      {%- comment -%}
        Logo sized by CSS height for presence; width follows the ratio, capped
        just above the merchant's logo width (and by the viewport on mobile).
        Requests a 2x source for a crisp retina render — final sharpness still
        depends on the merchant uploading a high-resolution logo file.
      {%- endcomment -%}
      {%- if logo_image != blank -%}
        {%- assign logo_cap = settings.logo_width | times: 130 | divided_by: 100 -%}
        {%- assign logo_1x = settings.logo_width | at_least: 200 -%}
        {%- assign logo_2x = logo_1x | times: 2 -%}
        <img
          src="{{ logo_image | image_url: width: logo_2x }}"
          srcset="{{ logo_image | image_url: width: logo_1x }} 1x, {{ logo_image | image_url: width: logo_2x }} 2x"
          width="{{ logo_image.width }}" height="{{ logo_image.height }}"
          alt="{{ shop.name | escape }}"
          style="max-width: min({{ logo_cap }}px, 52vw);"
          fetchpriority="high" decoding="async">
      {%- else -%}
        {{ shop.name | default: 'KYMRA' }}
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="{{ 'accessibility.primary_nav' | t }}">
        <ul class="nav__list">
          {%- for link in menu.links -%}
            {%- liquid
              assign has_children = false
              if link.links.size > 0
                assign has_children = true
              endif
              # Detect three-level nesting
              assign has_grandchildren = false
              for child in link.links
                if child.links.size > 0
                  assign has_grandchildren = true
                  break
                endif
              endfor
              # Count promo tiles attached to this top-level item (1 side promo, or 2 side-by-side)
              assign promo_count = 0
              for block in section.blocks
                if block.type == 'mega_promo' and block.settings.parent == link.title
                  assign promo_count = promo_count | plus: 1
                endif
              endfor
              if promo_count > 2
                assign promo_count = 2
              endif
            -%}
            <li class="nav__item{% if has_children %} nav__item--has-mega{% endif %}">
              <a class="nav__link" href="{{ link.url }}"
                {% if has_children %}aria-haspopup="true" aria-expanded="false"{% endif %}
                {% if link.active or link.child_active %}aria-current="page"{% endif %}>
                {{ link.title }}
                {%- if has_children -%}<span class="nav__caret">{% render 'icon', name: 'chevron-down' %}</span>{%- endif -%}
              </a>

              {%- if has_children -%}
                <div class="mega mega--columns{% if promo_count > 0 %} has-promo{% endif %}">
                  <div class="mega__inner container">
                    <div class="mega__cols">
                      {%- if has_grandchildren -%}
                        {%- for child in link.links -%}
                          <div class="mega__col">
                            <p class="mega__col-head">{{ child.title }}</p>
                            <ul class="mega__links">
                              {%- if child.links.size > 0 -%}
                                {%- for grandchild in child.links -%}
                                  {%- render 'nav-mega-link', link: grandchild -%}
                                {%- endfor -%}
                              {%- else -%}
                                {%- render 'nav-mega-link', link: child -%}
                              {%- endif -%}
                            </ul>
                          </div>
                        {%- endfor -%}
                      {%- else -%}
                        <div class="mega__col">
                          <p class="mega__col-head">{{ link.title }}</p>
                          <ul class="mega__links">
                            {%- for child in link.links -%}
                              {%- render 'nav-mega-link', link: child -%}
                            {%- endfor -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    </div>

                    {%- if promo_count > 0 -%}
                      <div class="mega__promos mega__promos--{{ promo_count }}">
                        {%- assign shown_promos = 0 -%}
                        {%- for block in section.blocks -%}
                          {%- if block.type == 'mega_promo' and block.settings.parent == link.title and shown_promos < 2 -%}
                            {%- comment -%} Without an image the tile still reads composed: panel-toned placeholder, ink caption. {%- endcomment -%}
                            <a class="mega-promo{% if block.settings.image == blank %} mega-promo--empty{% endif %}" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                              {% render 'responsive-image', image: block.settings.image, ratio: 'portrait', sizes: '260px', alt: block.settings.heading %}
                              <span class="mega-promo__scrim"></span>
                              <span class="mega-promo__caption">
                                {%- if block.settings.label != blank -%}<span class="mega-promo__label">{{ block.settings.label | escape }}</span>{%- endif -%}
                                <span class="mega-promo__title">{{ block.settings.heading | escape }}</span>
                                <span class="mega-promo__cta">{{ 'general.shop' | t }} {% render 'icon', name: 'arrow-right' %}</span>
                              </span>
                            </a>
                            {%- assign shown_promos = shown_promos | plus: 1 -%}
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="mega__footer container">
                    <a class="link-underline" href="{{ link.url }}">{{ 'general.view_all_title' | t: title: link.title }}</a>
                  </div>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
    </nav>

    <div class="header__actions">
      <a class="header__icon header__icon--desktop" href="{{ routes.search_url }}" data-drawer-open="search-drawer" aria-controls="search-drawer" aria-expanded="false" aria-label="{{ 'general.search.title' | t }}">
        {% render 'icon', name: 'search' %}
      </a>
      <a class="header__icon header__icon--desktop" href="{% if shop.customer_accounts_enabled %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ 'customer.account.title' | t }}">
        {% render 'icon', name: 'account' %}
      </a>
      <a class="header__icon" href="{{ routes.cart_url }}" data-drawer-open="cart-drawer" aria-label="{{ 'cart.general.title' | t }}" aria-controls="cart-drawer" aria-expanded="false">
        {% render 'icon', name: 'bag' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</div>

{%- comment -%} ===== Mobile menu drawer ===== {%- endcomment -%}
<div class="drawer drawer--left" id="menu-drawer" role="dialog" aria-modal="true" aria-label="{{ 'accessibility.menu' | t }}" aria-hidden="true">
  <div class="drawer__header">
    <span class="drawer__title">{{ 'general.menu' | t }}</span>
    <button class="drawer__close" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}" data-drawer-focus>
      {% render 'icon', name: 'close' %}
    </button>
  </div>
  <div class="drawer__body">
    <ul class="m-nav">
      {%- for link in menu.links -%}
        <li class="m-nav__item">
          {%- if link.links.size > 0 -%}
            <details class="m-nav__group">
              <summary class="m-nav__summary">
                {{ link.title }}
                <span class="m-nav__icon">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="m-nav__sub">
                <a class="m-nav__sub-link m-nav__sub-link--all" href="{{ link.url }}">{{ 'general.view_all_title' | t: title: link.title }}</a>
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    <p class="m-nav__sub-head">{{ child.title }}</p>
                    {%- for grandchild in child.links -%}
                      {%- render 'nav-mega-link', link: grandchild, mobile: true -%}
                    {%- endfor -%}
                  {%- else -%}
                    {%- render 'nav-mega-link', link: child, mobile: true -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </details>
          {%- else -%}
            <a class="m-nav__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="m-nav__utility">
      <a href="{% if shop.customer_accounts_enabled %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
        {% render 'icon', name: 'account' %} {{ 'customer.account.title' | t }}
      </a>
      <a href="{{ routes.search_url }}" data-drawer-open="search-drawer" aria-controls="search-drawer">{% render 'icon', name: 'search' %} {{ 'general.search.title' | t }}</a>
      {%- if settings.contact_phone != blank -%}
        <a href="tel:{{ settings.contact_phone | replace: ' ', '' }}">{% render 'icon', name: 'phone' %} {{ settings.contact_phone }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Overrides the theme logo. Empty = KYMRA wordmark."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    }
  ],
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Mega menu promo tile",
      "settings": [
        { "type": "paragraph", "content": "An image-led promo tile shown on the right of a mega menu. Add one tile for a single side promo, or two under the same menu item for a side-by-side pair. Link columns stay on the left." },
        { "type": "text", "id": "parent", "label": "Attach to menu item", "info": "Type the exact top-level menu title, e.g. Indoor. The tile appears in that item's mega menu." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait (4:5). A branded placeholder shows until you add one." },
        { "type": "text", "id": "label", "label": "Small-caps label", "info": "e.g. New in" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" },
        { "type": "url", "id": "link", "label": "Link", "info": "Where the tile goes — a collection, product or page." }
      ]
    }
  ]
}
{% endschema %}
