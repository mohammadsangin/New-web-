{%- comment -%}
  Journal — recent posts from a selected blog, editorial grid.
  Renders nothing on the storefront until a blog with at least one post is chosen.
{%- endcomment -%}
{%- assign jblog = blogs[section.settings.blog] -%}
{%- style -%}
  #shopify-section-{{ section.id }} .journal {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .journal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(24px, 4vw, 40px);
    margin-top: clamp(28px, 4vw, 48px);
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .journal__grid {
      grid-template-columns: repeat({{ section.settings.count }}, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .journal__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .journal__img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-lg, 14px);
  }
  #shopify-section-{{ section.id }} .journal__title {
    margin: 14px 0 4px;
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .journal__date {
    font-size: 13px;
    letter-spacing: 0.02em;
    color: var(--muted, #6A6459);
  }
{%- endstyle -%}
{%- if jblog != blank and jblog.articles_count > 0 -%}
  <section class="section journal">
    <div class="container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
        <div class="section-head section-head--center reveal">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
      {%- endif -%}
      <div class="journal__grid reveal">
        {%- for article in jblog.articles limit: section.settings.count -%}
          <a class="journal__card" href="{{ article.url }}">
            {%- if article.image != blank -%}
              <img class="journal__img"
                src="{{ article.image | image_url: width: 700 }}"
                srcset="{{ article.image | image_url: width: 700 }} 1x, {{ article.image | image_url: width: 1400 }} 2x"
                alt="{{ article.title | escape }}"
                width="700" height="467" loading="lazy" decoding="async">
            {%- endif -%}
            <p class="journal__title">{{ article.title | escape }}</p>
            <p class="journal__date">{{ article.published_at | date: "%B %-d, %Y" }}</p>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section journal">
    <div class="container">
      <div class="section-placeholder">
        <p>Choose a <strong>Blog</strong> in this section's settings (with at least one published post) to show your journal here.</p>
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Journal",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Pick the blog to pull posts from." },
    { "type": "range", "id": "count", "min": 2, "max": 4, "step": 1, "label": "Posts to show", "default": 3 },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ],
  "presets": [
    { "name": "Journal", "settings": { "blog": "news" } }
  ]
}
{% endschema %}
