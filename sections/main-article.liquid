<section class="page-hero">
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="container">
    <a href="{{ blog.url }}" style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-cream-muted);">
      ← Back to journal
    </a>
    <p class="eyebrow section-header__eyebrow" style="margin-top: 24px;">{{ article.tags | first | default: 'Article' }}</p>
    <h1 class="page-hero__title italic-em" style="max-width: 22ch;">{{ article.title }}</h1>
    <p style="margin-top: 24px; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-cream-faint);">
      {{ article.published_at | date: '%-d %B %Y' }} · {{ article.author }}
    </p>
  </div>
</section>

{%- if article.image != blank -%}
  <section class="container" style="padding-bottom: 60px;">
    <div class="border-glow" style="border-radius: 32px; overflow: hidden; aspect-ratio: 16/8; background: var(--color-charcoal);">
      <img
        src="{{ article.image | image_url: width: 1600 }}"
        alt="{{ article.image.alt | default: article.title }}"
        style="width:100%;height:100%;object-fit:cover;"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
        loading="eager"
      >
    </div>
  </section>
{%- endif -%}

<article class="container" style="padding-bottom: 80px;">
  <div class="rte" style="max-width: 760px; margin-inline: auto; font-size: 17px; line-height: 1.8; color: var(--color-cream-muted);">
    {{ article.content }}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
