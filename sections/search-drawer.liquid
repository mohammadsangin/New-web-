{%- comment -%}
  Search drawer — slides in from the right (same mechanics as the cart drawer).
  Input autofocuses on open and submits to Shopify's /search. Popular searches
  and the featured collection are Customizer-editable. Branded SVG placeholder
  fallback on featured images.
{%- endcomment -%}
<div class="drawer drawer--right search-drawer" id="search-drawer" role="dialog" aria-modal="true" aria-label="{{ 'general.search.title' | t }}" aria-hidden="true">
  <div class="drawer__header">
    <span class="drawer__title">{{ section.settings.heading | default: 'Search' | escape }}</span>
    <button class="drawer__close" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', name: 'close' %}</button>
  </div>

  <div class="drawer__body">
    <form class="search-drawer__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="search-drawer-input">{{ 'general.search.placeholder' | t }}</label>
      <span class="search-drawer__field">
        {% render 'icon', name: 'search' %}
        <input id="search-drawer-input" class="search-drawer__input" type="search" name="q"
          placeholder="{{ section.settings.placeholder | default: 'Search the collection…' | escape }}"
          autocomplete="off" autocorrect="off" spellcheck="false" data-drawer-focus>
      </span>
      <button type="submit" class="btn btn--block">{{ 'general.search.submit' | t }}</button>
    </form>

    {%- comment -%} Popular searches {%- endcomment -%}
    {%- assign popular_count = 0 -%}
    {%- for block in section.blocks -%}{%- if block.type == 'popular' and block.settings.label != blank -%}{%- assign popular_count = popular_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
    {%- if popular_count > 0 -%}
      <div class="search-drawer__section">
        <p class="eyebrow">{{ section.settings.popular_heading | default: 'Popular searches' | escape }}</p>
        <ul class="search-pop">
          {%- for block in section.blocks -%}
            {%- if block.type == 'popular' and block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}>
                {%- if block.settings.url != blank -%}
                  <a class="search-pop__link" href="{{ block.settings.url }}">{% render 'icon', name: 'search' %}<span>{{ block.settings.label | escape }}</span></a>
                {%- else -%}
                  <a class="search-pop__link" href="{{ routes.search_url }}?q={{ block.settings.label | url_encode }}">{% render 'icon', name: 'search' %}<span>{{ block.settings.label | escape }}</span></a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    {%- comment -%} Featured products {%- endcomment -%}
    {%- assign fcoll = collections[section.settings.featured_collection] -%}
    {%- if fcoll != blank and fcoll.products.size > 0 -%}
      <div class="search-drawer__section">
        <p class="eyebrow">{{ section.settings.featured_heading | default: 'Featured' | escape }}</p>
        <div class="search-feat">
          {%- for product in fcoll.products limit: section.settings.featured_count -%}
            <a class="search-feat__card" href="{{ product.url }}">
              <span class="search-feat__media">
                {% render 'responsive-image', image: product.featured_media, ratio: 'square', sizes: '140px', alt: product.title %}
              </span>
              <span class="search-feat__title">{{ product.title }}</span>
              <span class="search-feat__price">{{ product.price | money }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search drawer",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Search the collection…" },
    { "type": "header", "content": "Popular searches" },
    { "type": "text", "id": "popular_heading", "label": "Heading", "default": "Popular searches" },
    { "type": "header", "content": "Featured" },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Featured" },
    { "type": "collection", "id": "featured_collection", "label": "Featured collection", "info": "Products shown in the search drawer." },
    { "type": "range", "id": "featured_count", "min": 2, "max": 6, "step": 1, "label": "Products to show", "default": 4 }
  ],
  "blocks": [
    {
      "type": "popular",
      "name": "Popular search",
      "settings": [
        { "type": "text", "id": "label", "label": "Term" },
        { "type": "url", "id": "url", "label": "Link", "info": "Optional. Leave empty to search for the term." }
      ]
    }
  ],
  "default": {
    "settings": {},
    "blocks": [
      { "type": "popular", "settings": { "label": "Chandeliers" } },
      { "type": "popular", "settings": { "label": "Brass Pendants" } },
      { "type": "popular", "settings": { "label": "Wall Lights" } },
      { "type": "popular", "settings": { "label": "Made to Order" } }
    ]
  }
}
{% endschema %}
