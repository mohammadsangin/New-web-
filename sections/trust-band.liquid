{%- comment -%} Trust band — honest, consistent 1.5px icon set. {%- endcomment -%}
<section class="trust section--tight">
  <div class="container">
    <div class="trust__grid">
      {%- for block in section.blocks -%}
        <div class="trust__item reveal" {{ block.shopify_attributes }}>
          <span class="trust__icon">{% render 'icon', name: block.settings.icon %}</span>
          <h3 class="trust__title">{{ block.settings.title | escape }}</h3>
          <p class="trust__text">{{ block.settings.text | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust band",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "clock", "label": "Made to order" },
            { "value": "refresh", "label": "Returns" },
            { "value": "headset", "label": "Expert advice" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "leaf", "label": "Sustainable" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free UK delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "On all orders over £300, to your door." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust band",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Free UK delivery", "text": "On all orders over £300, to your door." } },
        { "type": "item", "settings": { "icon": "clock", "title": "Made to order", "text": "Cast for you — please allow 3–4 weeks." } },
        { "type": "item", "settings": { "icon": "refresh", "title": "30-day returns", "text": "Not quite right? Return within 30 days." } },
        { "type": "item", "settings": { "icon": "headset", "title": "Expert advice", "text": "Speak to us on 0333 090 0045." } }
      ]
    }
  ]
}
{% endschema %}
