{%- comment -%}
  Journal — the 3 most recent articles from a merchant-selected blog.
  Reuses the article-card pattern. If the blog has no articles yet, nothing
  renders on the storefront; a calm note shows in the theme editor only.
{%- endcomment -%}
{%- liquid
  assign blog_obj = blogs[section.settings.blog]
  assign count = section.settings.posts_to_show | default: 3
-%}
{%- if blog_obj != blank and blog_obj.articles_count > 0 -%}
  <section class="section">
    <div class="container">
      <div class="row-head reveal">
        <div class="row-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a class="row-head__link link-underline" href="{{ blog_obj.url }}">{{ section.settings.view_all_label | default: 'View the journal' | escape }}</a>
        {%- endif -%}
      </div>

      <div class="article-grid">
        {%- for article in blog_obj.articles limit: count -%}
          <article class="article-card reveal">
            <a class="article-card__media media" href="{{ article.url }}" tabindex="-1" aria-hidden="true" style="aspect-ratio:3/2;">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 800 }}"
                  srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1000 }} 1000w"
                  sizes="(min-width: 990px) 33vw, (min-width: 700px) 50vw, 100vw"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  width="{{ article.image.width }}" height="{{ article.image.height }}"
                  loading="lazy" decoding="async">
              {%- else -%}
                {% render 'placeholder' %}
              {%- endif -%}
            </a>
            <p class="article-card__meta">{{ article.published_at | date: '%d %B %Y' }}</p>
            <h3 class="article-card__title"><a class="article-card__stretch" href="{{ article.url }}">{{ article.title }}</a></h3>
            {%- if article.excerpt_or_content != blank -%}
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  {%- comment -%} Editor-only guidance — never shown on the live storefront. {%- endcomment -%}
  <section class="section">
    <div class="container">
      <div class="section-head--center">
        <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | default: 'The journal' | escape }}</p>
        {%- if blog_obj == blank -%}
          <p class="section-head__body">Journal is ready — choose a blog in this section's settings (<strong>Blog</strong>). Its three most recent published articles will appear here on the storefront.</p>
        {%- else -%}
          <p class="section-head__body">The blog “{{ blog_obj.title | escape }}” has no published articles yet. Publish articles to it and they'll show here (this notice is only visible in the editor).</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes on light" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "The three most recent articles are shown." },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 3, "step": 1, "label": "Articles to show", "default": 3 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view the journal' link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View the journal" }
  ],
  "presets": [{ "name": "Journal", "settings": { "blog": "news" } }]
}
{% endschema %}
