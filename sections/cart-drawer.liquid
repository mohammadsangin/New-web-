{%- comment -%}
  Thin section wrapper around the cart-drawer snippet. Exists so the drawer can
  be re-rendered on AJAX cart changes via the Section Rendering API
  (`?sections=cart-drawer`). The drawer itself is rendered globally in
  layout/theme.liquid via {% render 'cart-drawer' %}.
{%- endcomment -%}
{%- render 'cart-drawer', cross_collection_handle: section.settings.cross_sell_collection -%}

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "Cross-sell collection",
      "info": "Overrides the theme-level cross-sell collection for the drawer."
    }
  ]
}
{% endschema %}
