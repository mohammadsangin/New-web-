{%- comment -%}
  Cart drawer — the ONLY source of the drawer markup. Rendered statically in
  layout/theme.liquid via {% section 'cart-drawer' %}, and re-rendered on AJAX
  cart changes via the Cart AJAX API `sections` bundling (with a
  ?section_id=cart-drawer fallback). Everything that changes lives inside
  .drawer__wrap — JS swaps only its innerHTML, so the #cart-drawer element and
  all delegated handlers persist across refreshes.
{%- endcomment -%}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign cross_collection = collections[section.settings.cross_sell_collection] | default: collections[settings.cart_cross_sell]
-%}
<div class="drawer drawer--right cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}" aria-hidden="true">
  <div class="drawer__wrap" style="display:flex;flex-direction:column;height:100%;">
    <div class="drawer__header">
      <span class="drawer__title">{{ 'cart.general.title' | t }} <span data-cart-count-inline>({{ cart.item_count }})</span></span>
      <button class="drawer__close" type="button" data-drawer-close aria-label="{{ 'accessibility.close' | t }}" data-drawer-focus>
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__body">
        {%- if threshold > 0 -%}
          {%- liquid
            assign remaining = threshold | minus: cart.total_price
            assign pct = cart.total_price | times: 100.0 | divided_by: threshold
            if pct > 100
              assign pct = 100
            endif
          -%}
          <div class="cart-progress">
            {%- if remaining > 0 -%}
              <p class="cart-progress__text">{{ 'cart.general.free_shipping_progress_html' | t: amount: remaining | money }}</p>
            {%- else -%}
              <p class="cart-progress__text">{{ 'cart.general.free_shipping_qualified' | t }}</p>
            {%- endif -%}
            <div class="cart-progress__bar"><div class="cart-progress__fill" style="width: {{ pct }}%"></div></div>
          </div>
        {%- endif -%}

        <ul class="cart-items">
          {%- for item in cart.items -%}
            <li class="cart-item" data-cart-line="{{ forloop.index }}">
              <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" width="72" height="90" loading="lazy">
                {%- endif -%}
              </a>
              <div class="cart-item__info">
                <div class="cart-item__top">
                  <div>
                    <p class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                    {%- unless item.product.has_only_default_variant -%}
                      <p class="cart-item__variant">{{ item.variant.title }}</p>
                    {%- endunless -%}
                    {%- if item.selling_plan_allocation -%}
                      <p class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                    {%- endif -%}
                  </div>
                  <button class="cart-item__remove" type="button" data-cart-remove="{{ item.key }}" aria-label="{{ 'cart.general.remove' | t }} {{ item.product.title | escape }}">
                    {% render 'icon', name: 'close' %}
                  </button>
                </div>
                <div class="cart-item__bottom">
                  <div class="qty">
                    <button type="button" data-cart-step="-1" data-cart-key="{{ item.key }}" aria-label="{{ 'cart.general.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                    <input type="number" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-qty data-cart-key="{{ item.key }}" aria-label="{{ 'cart.general.quantity' | t }}">
                    <button type="button" data-cart-step="1" data-cart-key="{{ item.key }}" aria-label="{{ 'cart.general.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <span class="cart-item__price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- comment -%}
          Cross-sell strip: up to 6 products from the merchant-assigned
          collection, ~3 visible with smooth vertical scroll for the rest.
          Whole card links to the product; single-variant products get a
          quiet quick-add. Renders only when the collection is assigned.
        {%- endcomment -%}
        {%- if cross_collection and cross_collection.products.size > 0 -%}
          {%- liquid
            assign in_cart_ids = cart.items | map: 'product_id' | join: ','
            assign in_cart_ids = in_cart_ids | prepend: ',' | append: ','
            assign cross_shown = 0
          -%}
          {%- capture cross_cards -%}
            {%- for product in cross_collection.products -%}
              {%- assign needle = product.id | prepend: ',' | append: ',' -%}
              {%- if in_cart_ids contains needle or cross_shown >= 6 -%}{%- continue -%}{%- endif -%}
              {%- assign cross_shown = cross_shown | plus: 1 -%}
              {%- assign v = product.selected_or_first_available_variant -%}
              <div class="cross-card">
                <span class="cross-card__media media ratio-square">
                  {%- if product.featured_media -%}
                    <img src="{{ product.featured_media | image_url: width: 128 }}"
                      srcset="{{ product.featured_media | image_url: width: 128 }} 1x, {{ product.featured_media | image_url: width: 256 }} 2x"
                      alt="" width="64" height="64" loading="lazy" decoding="async">
                  {%- else -%}
                    {% render 'placeholder' %}
                  {%- endif -%}
                </span>
                <span class="cross-card__info">
                  <a class="cross-card__link" href="{{ product.url }}">{{ product.title }}</a>
                  <span class="cross-card__price">{% render 'price', product: product %}</span>
                </span>
                {%- if product.has_only_default_variant and v and v.available -%}
                  <button class="cross-card__add" type="button" data-cart-add="{{ v.id }}" aria-label="{{ 'cart.general.add_product' | t: title: product.title }}">
                    {{ 'cart.general.add' | t }} {% render 'icon', name: 'plus' %}
                  </button>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endcapture -%}
          {%- if cross_shown > 0 -%}
            <div class="cart-cross">
              <p class="eyebrow">{{ 'cart.general.complete_the_look' | t }}</p>
              <div class="cart-cross__scroll" tabindex="0" role="group" aria-label="{{ 'cart.general.complete_the_look' | t }}">
                {{ cross_cards }}
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>

      <div class="cart-foot">
        <div class="cart-foot__row">
          <span class="cart-foot__label">{{ 'cart.general.subtotal' | t }}</span>
          <span class="cart-foot__total">{{ cart.total_price | money }}</span>
        </div>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn--block btn--lg">{{ 'cart.general.checkout' | t }}</button>
        </form>
        <p class="cart-foot__note">{{ 'cart.general.taxes_note' | t }}</p>
        <a class="cart-foot__continue link-underline" href="{{ routes.all_products_collection_url }}" data-drawer-close>{{ 'cart.general.continue' | t }}</a>
      </div>
    {%- else -%}
      <div class="drawer__body">
        <div class="cart-empty">
          <span class="cart-empty__icon">{% render 'icon', name: 'bag' %}</span>
          <p class="cart-empty__title">{{ 'cart.general.empty_title' | t }}</p>
          <p class="cart-empty__text">{{ 'cart.general.empty_body' | t }}</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}" data-drawer-close>{{ 'cart.general.start_shopping' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "collection",
      "id": "cross_sell_collection",
      "label": "Cross-sell collection",
      "info": "Overrides the theme-level cross-sell collection (Theme settings → Cart)."
    }
  ]
}
{% endschema %}
