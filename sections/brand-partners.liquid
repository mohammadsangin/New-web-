{%- comment -%}
  Brand Partners — a "brands we carry" logo strip.
  Logos upload DIRECTLY in this section's settings (Logo 1–8) — no nested blocks.
  Empty slots are skipped. Renders nothing on the live storefront until at least
  one logo is set; shows an honest hint in the theme editor.
{%- endcomment -%}

{%- liquid
  assign per_row = section.settings.logos_per_row | default: 5
  assign has_logos = false
  for i in (1..8)
    assign lkey = 'logo_' | append: i
    if section.settings[lkey] != blank
      assign has_logos = true
      break
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .brand-partners {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% if section.settings.background != blank %}background: {{ section.settings.background }};{% else %}background: var(--bg, #F5F1E9);{% endif %}
  }
  #shopify-section-{{ section.id }} .brand-partners__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 4vw, 44px) clamp(16px, 3vw, 40px);
    align-items: center;
    margin-top: clamp(28px, 4vw, 48px);
  }
  @media (min-width: 600px) {
    #shopify-section-{{ section.id }} .brand-partners__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .brand-partners__grid {
      grid-template-columns: repeat({{ per_row }}, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .brand-partners__item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 64px;
  }
  #shopify-section-{{ section.id }} .brand-partners__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .brand-partners__logo {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 56px;
    object-fit: contain;
  }
  {%- if section.settings.monochrome -%}
  #shopify-section-{{ section.id }} .brand-partners__logo {
    filter: grayscale(1);
    opacity: 0.62;
    transition: filter var(--dur-hover, 180ms) var(--ease, ease), opacity var(--dur-hover, 180ms) var(--ease, ease);
  }
  #shopify-section-{{ section.id }} .brand-partners__item:hover .brand-partners__logo,
  #shopify-section-{{ section.id }} .brand-partners__link:focus-visible .brand-partners__logo {
    filter: grayscale(0);
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .brand-partners__logo { transition: none; }
  }
  {%- endif -%}
{%- endstyle -%}

{%- if has_logos -%}
  <section class="section brand-partners">
    <div class="container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="section-head section-head--center reveal">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="section-head__body">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="brand-partners__grid reveal">
        {%- for i in (1..8) -%}
          {%- assign lkey = 'logo_' | append: i -%}
          {%- assign ukey = 'link_' | append: i -%}
          {%- assign logo = section.settings[lkey] -%}
          {%- assign url = section.settings[ukey] -%}
          {%- if logo != blank -%}
            {%- liquid
              assign logo_w = 240
              if logo.width < logo_w
                assign logo_w = logo.width
              endif
              assign logo_h = logo.height | times: logo_w | divided_by: logo.width
              assign brand_name = logo.alt | default: 'Brand'
            -%}
            {%- capture logo_img -%}
              <img
                class="brand-partners__logo"
                src="{{ logo | image_url: width: logo_w }}"
                srcset="{{ logo | image_url: width: logo_w }} 1x, {{ logo | image_url: width: 480 }} 2x"
                alt="{{ brand_name | escape }}"
                width="{{ logo_w }}"
                height="{{ logo_h }}"
                loading="lazy"
                decoding="async">
            {%- endcapture -%}
            <div class="brand-partners__item">
              {%- if url != blank -%}
                <a class="brand-partners__link" href="{{ url }}" aria-label="{{ brand_name | escape }}">{{ logo_img }}</a>
              {%- else -%}
                <span class="brand-partners__link">{{ logo_img }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section brand-partners">
    <div class="container">
      <div class="section-head section-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      <div class="section-placeholder">
        <p>Scroll down in this section's settings to <strong>Logo 1, Logo 2, Logo 3…</strong> and upload a logo into each. Empty slots are skipped, and the section stays hidden on your live store until at least one logo is added.</p>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Brand Partners",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Considered company" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brands we carry" },
    { "type": "textarea", "id": "subheading", "label": "Subtext", "default": "A curated group of makers whose craft and finish sit comfortably alongside our own." },
    { "type": "header", "content": "Brand logos", "info": "Upload a logo into each slot. A transparent PNG or SVG works best. Empty slots are ignored." },
    { "type": "image_picker", "id": "logo_1", "label": "Logo 1" },
    { "type": "url", "id": "link_1", "label": "Logo 1 link (optional)" },
    { "type": "image_picker", "id": "logo_2", "label": "Logo 2" },
    { "type": "url", "id": "link_2", "label": "Logo 2 link (optional)" },
    { "type": "image_picker", "id": "logo_3", "label": "Logo 3" },
    { "type": "url", "id": "link_3", "label": "Logo 3 link (optional)" },
    { "type": "image_picker", "id": "logo_4", "label": "Logo 4" },
    { "type": "url", "id": "link_4", "label": "Logo 4 link (optional)" },
    { "type": "image_picker", "id": "logo_5", "label": "Logo 5" },
    { "type": "url", "id": "link_5", "label": "Logo 5 link (optional)" },
    { "type": "image_picker", "id": "logo_6", "label": "Logo 6" },
    { "type": "url", "id": "link_6", "label": "Logo 6 link (optional)" },
    { "type": "image_picker", "id": "logo_7", "label": "Logo 7" },
    { "type": "url", "id": "link_7", "label": "Logo 7 link (optional)" },
    { "type": "image_picker", "id": "logo_8", "label": "Logo 8" },
    { "type": "url", "id": "link_8", "label": "Logo 8 link (optional)" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "logos_per_row", "min": 2, "max": 6, "step": 1, "label": "Logos per row (desktop)", "default": 5 },
    { "type": "checkbox", "id": "monochrome", "label": "Monochrome logos", "info": "Show logos in muted greyscale, returning to full colour on hover or focus.", "default": true },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave blank to use the theme's default page tone." }
  ],
  "presets": [
    { "name": "Brand Partners" }
  ]
}
{% endschema %}
