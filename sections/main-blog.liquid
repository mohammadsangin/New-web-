<section class="page-hero">
  <div class="page-hero__glow" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow section-header__eyebrow">Journal</p>
    <h1 class="page-hero__title italic-em">{{ blog.title }}</h1>
  </div>
</section>

<section class="container" style="padding-bottom: 80px;">
  {%- paginate blog.articles by 12 -%}
    <div style="display: grid; grid-template-columns: 1fr; gap: 32px;" class="blog-grid">
      <style>
        @media (min-width: 640px) { .blog-grid { grid-template-columns: 1fr 1fr; } }
        @media (min-width: 1024px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }
      </style>
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="border-glow" style="display: block; border-radius: 24px; overflow: hidden;">
          <div style="aspect-ratio: 4/3; background: var(--color-charcoal); position: relative;">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 800 }}"
                alt="{{ article.image.alt | default: article.title }}"
                style="width:100%;height:100%;object-fit:cover;"
                loading="lazy"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
              >
            {%- endif -%}
          </div>
          <div style="padding: 24px; background: hsla(20,14%,9%,0.7);">
            <span class="eyebrow" style="color: hsla(38,55%,68%,0.85);">{{ article.tags | first | default: 'Article' }}</span>
            <h3 class="font-display" style="margin-top: 12px; font-size: 22px; line-height: 1.2; color: var(--color-cream);">{{ article.title }}</h3>
            <p style="margin-top: 12px; font-size: 13px; color: var(--color-cream-muted);">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            <p style="margin-top: 16px; font-size: 11px; color: var(--color-cream-faint);">{{ article.published_at | date: '%-d %B %Y' }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__current">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
