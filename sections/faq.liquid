{%- comment -%}
  FAQ — frequently asked questions. Reuses the theme's native
  <details>/<summary> accordion pattern (.accordions[data-accordion-group]),
  which gives smooth icon animation and one-open-at-a-time exclusive
  behaviour via initAccordions() in theme.js.

  Block-driven: each block is one question + richtext answer. This section
  ships pre-filled from templates/index.json, so it renders on the live
  storefront out of the box. Empty blocks (no question) render nothing.
{%- endcomment -%}

{%- liquid
  assign has_questions = false
  for block in section.blocks
    if block.settings.question != blank
      assign has_questions = true
      break
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .faq {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% if section.settings.background != blank %}background: {{ section.settings.background }};{% else %}background: var(--bg, #F5F1E9);{% endif %}
  }
  #shopify-section-{{ section.id }} .faq__list {
    max-width: 760px;
    margin-inline: auto;
    margin-top: clamp(28px, 4vw, 48px);
    background: var(--surface, #FEFDFB);
    border: 1px solid var(--hairline, #DED7C7);
    border-radius: var(--radius-lg, 16px);
    padding: clamp(8px, 2vw, 20px) clamp(18px, 3vw, 32px);
  }
  #shopify-section-{{ section.id }} .faq__list.accordions { border-top: none; }
  #shopify-section-{{ section.id }} .faq .accordion:last-child { border-bottom: none; }
  #shopify-section-{{ section.id }} .faq .accordion__body p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .faq .accordion__body {
    overflow: hidden;
    animation: faq-open-{{ section.id }} var(--dur-hover, 180ms) var(--ease, ease);
  }
  @keyframes faq-open-{{ section.id }} {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .faq .accordion__body { animation: none; }
    #shopify-section-{{ section.id }} .faq .accordion__icon { transition: none; }
  }
{%- endstyle -%}

{%- if has_questions -%}
  <section class="section faq">
    <div class="container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="section-head section-head--center reveal">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="section-head__body">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="faq__list accordions reveal" data-accordion-group>
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary class="accordion__summary">
                {{ block.settings.question | escape }}
                <span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
              </summary>
              <div class="accordion__body rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} FAQPage structured data — populated questions only. {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign q_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- if q_index > 0 -%},{%- endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
              }
            }
            {%- assign q_index = q_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- elsif request.design_mode -%}
  <section class="section faq">
    <div class="container">
      <div class="section-head section-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      <div class="section-placeholder">
        <p>Add a <strong>Question</strong> block for each entry — a question and its answer. Questions with no text won’t appear on your live storefront.</p>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Good to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "subheading", "label": "Subtext" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave blank to use the theme’s default page tone." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
