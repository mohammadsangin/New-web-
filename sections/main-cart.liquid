{%- comment -%} Main cart page. AJAX updates via the same handlers as the drawer. {%- endcomment -%}
<section class="cart-page" id="main-cart">
  <div class="cart-page__wrap container">
    <h1 class="cart-page__title">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <div class="cart-page__grid">
        <div class="cart-page__items">
          <div class="cart-table">
            {%- for item in cart.items -%}
              <div class="cart-row" data-cart-line="{{ forloop.index }}">
                <a class="cart-row__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="96" height="120" loading="lazy">
                  {%- endif -%}
                </a>
                <div class="cart-row__info">
                  <p class="cart-row__title"><a href="{{ item.url }}">{{ item.product.title }}</a></p>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-row__variant">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  {%- if item.selling_plan_allocation -%}
                    <p class="cart-row__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}
                  <div class="cart-row__controls">
                    <div class="qty">
                      <button type="button" data-cart-step="-1" data-cart-key="{{ item.key }}" aria-label="{{ 'cart.general.decrease' | t }}">{% render 'icon', name: 'minus' %}</button>
                      <input type="number" value="{{ item.quantity }}" min="0" inputmode="numeric" data-cart-qty data-cart-key="{{ item.key }}" aria-label="{{ 'cart.general.quantity' | t }}">
                      <button type="button" data-cart-step="1" data-cart-key="{{ item.key }}" aria-label="{{ 'cart.general.increase' | t }}">{% render 'icon', name: 'plus' %}</button>
                    </div>
                    <button class="cart-row__remove" type="button" data-cart-remove="{{ item.key }}">{{ 'cart.general.remove' | t }}</button>
                  </div>
                </div>
                <div class="cart-row__price">{{ item.final_line_price | money }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        <aside class="cart-page__summary">
          <div class="cart-summary">
            <h2 class="cart-summary__title">{{ 'cart.general.summary' | t }}</h2>
            <div class="cart-summary__row">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <div class="cart-summary__row cart-summary__row--total">
              <span>{{ 'cart.general.total' | t }}</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="cart-summary__note">{{ 'cart.general.taxes_note' | t }}</p>
            <form action="{{ routes.cart_url }}" method="post">
              <button type="submit" name="checkout" class="btn btn--block btn--lg">{{ 'cart.general.checkout' | t }}</button>
            </form>
            <a class="cart-foot__continue link-underline" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue' | t }}</a>
          </div>
        </aside>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <span class="cart-empty__icon">{% render 'icon', name: 'bag' %}</span>
        <p class="cart-empty__title">{{ 'cart.general.empty_title' | t }}</p>
        <p class="cart-empty__text">{{ 'cart.general.empty_body' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.start_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
