{%- comment -%} Featured collection row — reusable, identical product-card. {%- endcomment -%}
{%- liquid
  assign collection = collections[section.settings.collection]
  assign count = section.settings.products_to_show
  assign grid_class = 'product-grid'
  if section.settings.columns == '4'
    assign grid_class = 'product-grid product-grid--4'
  endif
-%}
{%- comment -%}
  Renders real products when a collection is assigned (Collection setting).
  On the live storefront it outputs nothing until then; in the theme editor it
  shows a clear prompt so the merchant knows exactly what to set.
{%- endcomment -%}
{%- if collection != blank and collection.products.size > 0 -%}
  <section class="section">
    <div class="container">
      <div class="row-head reveal">
        <div class="row-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <p class="section-head__body">{{ section.settings.body | escape }}</p>
          {%- endif -%}
        </div>
        {%- if section.settings.show_view_all -%}
          <a class="row-head__link link-underline" href="{{ collection.url }}">{{ section.settings.view_all_label | default: 'View all' | escape }}</a>
        {%- endif -%}
      </div>

      <div class="{{ grid_class }}">
        {%- for product in collection.products limit: count -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section">
    <div class="container">
      <div class="row-head">
        <div class="row-head__text">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        </div>
      </div>
      <div class="section-placeholder">
        {%- if collection == blank -%}
          <p>Assign a collection to this section's <strong>Collection</strong> setting to show products here.</p>
        {%- else -%}
          <p>The collection “{{ collection.title | escape }}” has no products yet.</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in brass" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 4 },
    {
      "type": "select", "id": "columns", "label": "Desktop columns", "default": "4",
      "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
