{%- comment -%}
  Footer — editorial, premium. Structure:
    · optional slim trust strip (delivery / made-to-order / returns / advice)
    · dark brand band: large KYMRA wordmark + one-line statement + brass hairline
    · link columns (block-driven, graceful when a menu is empty) + newsletter
    · social + payment icons
    · bottom line: copyright + registered office only
  Block types 'menu' and 'newsletter' and their setting ids are preserved so
  merchant-saved settings keep rendering.
{%- endcomment -%}
<footer class="footer">
  {%- if section.settings.show_trust_strip -%}
    <div class="footer-trust">
      <div class="container footer-trust__grid">
        {%- if section.settings.trust_delivery != blank -%}
          <div class="footer-trust__item">{% render 'icon', name: 'truck' %}<span>{{ section.settings.trust_delivery | escape }}</span></div>
        {%- endif -%}
        {%- if section.settings.trust_made != blank -%}
          <div class="footer-trust__item">{% render 'icon', name: 'clock' %}<span>{{ section.settings.trust_made | escape }}</span></div>
        {%- endif -%}
        {%- if section.settings.trust_returns != blank -%}
          <div class="footer-trust__item">{% render 'icon', name: 'refresh' %}<span>{{ section.settings.trust_returns | escape }}</span></div>
        {%- endif -%}
        {%- if section.settings.trust_advice != blank -%}
          <div class="footer-trust__item">{% render 'icon', name: 'headset' %}<span>{{ section.settings.trust_advice | escape }}</span></div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ===== Brand band ===== {%- endcomment -%}
  <div class="footer__brandband">
    <div class="container footer__brandband-inner">
      <a class="footer__wordmark" href="{{ routes.root_url }}">{{ section.settings.brand_name | default: shop.name | default: 'KYMRA' }}</a>
      <span class="footer__hairline" aria-hidden="true"></span>
      {%- if section.settings.tagline != blank -%}
        <p class="footer__statement">{{ section.settings.tagline | escape }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="container">
    {%- comment -%} ===== Link columns + newsletter ===== {%- endcomment -%}
    {%- liquid
      assign show_contact = false
      if section.settings.show_contact_column
        if settings.contact_phone != blank or settings.contact_email != blank
          assign show_contact = true
        endif
      endif
    -%}
    <div class="footer__main">
      <div class="footer__menus">
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            {%- assign fmenu = linklists[block.settings.menu] -%}
            {%- if fmenu != blank and fmenu.links.size > 0 -%}
              <nav class="footer__col" aria-label="{{ block.settings.heading | default: fmenu.title | escape }}" {{ block.shopify_attributes }}>
                <p class="footer__col-head">{{ block.settings.heading | default: fmenu.title | escape }}</p>
                <ul class="footer__links">
                  {%- for link in fmenu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Contact column — real details, always tidy even before menus are assigned {%- endcomment -%}
        {%- if show_contact -%}
          <div class="footer__col">
            <p class="footer__col-head">{{ 'general.footer.contact' | t }}</p>
            <ul class="footer__links">
              {%- if settings.contact_phone != blank -%}
                <li><a href="tel:{{ settings.contact_phone | replace: ' ', '' }}">{{ settings.contact_phone }}</a></li>
              {%- endif -%}
              {%- if settings.contact_email != blank -%}
                <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'newsletter' -%}
          <div class="footer__newsletter" {{ block.shopify_attributes }}>
            <p class="eyebrow eyebrow--on-dark">{{ block.settings.eyebrow | default: 'The list' | escape }}</p>
            {%- if block.settings.heading != blank -%}<p class="footer__news-head">{{ block.settings.heading | escape }}</p>{%- endif -%}
            {%- if block.settings.body != blank -%}<p class="footer__news-body">{{ block.settings.body | escape }}</p>{%- endif -%}
            {%- form 'customer', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="footer-newsletter">{{ 'newsletter.email' | t }}</label>
              <input id="footer-newsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required autocomplete="email">
              <button type="submit" aria-label="{{ 'newsletter.subscribe' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
              {%- if form.posted_successfully? -%}
                <p class="form-note form-note--success" style="flex-basis:100%;">{{ 'newsletter.success' | t }}</p>
              {%- elsif form.errors -%}
                <p class="form-note form-note--error" style="flex-basis:100%;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ===== Social + payments ===== {%- endcomment -%}
    {%- liquid
      assign has_social = false
      if settings.social_instagram != blank or settings.social_pinterest != blank or settings.social_facebook != blank
        assign has_social = true
      endif
    -%}
    {%- if has_social or section.settings.show_payments -%}
      <div class="footer__utility">
        {%- if has_social -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a>
            {%- endif -%}
            {%- if settings.social_pinterest != blank -%}
              <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" rel="noopener" target="_blank">{% render 'icon', name: 'pinterest' %}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
          <div class="footer__payments">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} ===== Bottom line: copyright + registered office only ===== {%- endcomment -%}
    <div class="footer__bottom">
      <p class="footer__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}
        {%- if section.settings.policy_menu != blank -%}
          {%- for link in linklists[section.settings.policy_menu].links -%}
            <span class="footer__dot">&middot;</span> <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </p>
      {%- if settings.registered_office != blank -%}
        <address class="footer__address">{{ settings.registered_office | escape }}</address>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "KYMRA" },
    { "type": "textarea", "id": "tagline", "label": "Brand statement", "default": "Solid brass lighting for considered interiors. Period & Art Deco, made to order in the UK." },
    { "type": "header", "content": "Trust strip" },
    { "type": "checkbox", "id": "show_trust_strip", "label": "Show trust strip", "default": true },
    { "type": "text", "id": "trust_delivery", "label": "Delivery", "default": "Free UK delivery over £300" },
    { "type": "text", "id": "trust_made", "label": "Made to order", "default": "Made to order — allow 3–4 weeks" },
    { "type": "text", "id": "trust_returns", "label": "Returns", "default": "30-day returns" },
    { "type": "text", "id": "trust_advice", "label": "Expert advice", "default": "Expert advice — 0333 090 0045" },
    { "type": "header", "content": "Link columns" },
    { "type": "checkbox", "id": "show_contact_column", "label": "Show contact column", "info": "Adds a tidy column with the phone and email from Theme settings → Contact.", "default": true },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true },
    { "type": "link_list", "id": "policy_menu", "label": "Policy / legal menu", "info": "Shown in the bottom bar." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Empty menus are skipped automatically." }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The list" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Considered new pieces and interior notes. No noise." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Explore" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
