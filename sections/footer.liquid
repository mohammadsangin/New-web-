{%- comment -%}
  Footer — editorial, premium. Structure:
    · link columns (block-driven, graceful when a menu is empty) + newsletter
    · social + payment icons
    · bottom line: copyright + registered office only
  Block types 'menu' and 'newsletter' and their setting ids are preserved so
  merchant-saved settings keep rendering.
{%- endcomment -%}
<footer class="footer">
  <div class="container">
    {%- comment -%} ===== Company info · quick links · menu columns · newsletter ===== {%- endcomment -%}
    <div class="footer__main">
      <div class="footer__menus">

        {%- comment -%} COLUMN A — Company information (settings-driven, real data defaults), grouped for rhythm {%- endcomment -%}
        {%- if section.settings.show_company -%}
          <div class="footer__col footer__col--company">
            <p class="footer__col-head">{{ section.settings.company_heading | default: 'Company information' | escape }}</p>
            <div class="footer__company">
              {%- if section.settings.company_name != blank -%}
                <p class="footer__company-name">{{ section.settings.company_name | escape }}</p>
              {%- endif -%}
              {%- if section.settings.company_number != blank or section.settings.company_dpa != blank -%}
                <p class="footer__company-reg">
                  {%- if section.settings.company_number != blank -%}<span>{{ section.settings.company_number | escape }}</span>{%- endif -%}
                  {%- if section.settings.company_dpa != blank -%}<span>{{ section.settings.company_dpa | escape }}</span>{%- endif -%}
                </p>
              {%- endif -%}
              {%- if section.settings.company_address != blank -%}
                <address class="footer__company-address">{{ section.settings.company_address | escape }}</address>
              {%- endif -%}
              {%- if settings.contact_phone != blank or settings.contact_email != blank -%}
                <p class="footer__company-contact">
                  {%- if settings.contact_phone != blank -%}<a href="tel:{{ settings.contact_phone | replace: ' ', '' }}">{{ settings.contact_phone }}</a>{%- endif -%}
                  {%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>{%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- comment -%}
          COLUMN B — Quick links. Merchant-editable "Quick link" blocks; when
          none have been added yet, a sensible default set renders so the
          footer never reads empty (edit/reorder via blocks in the Customizer).
        {%- endcomment -%}
        {%- assign quick_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'link' and block.settings.label != blank -%}{%- assign quick_count = quick_count | plus: 1 -%}{%- endif -%}
        {%- endfor -%}
        <nav class="footer__col" aria-label="{{ section.settings.quick_links_heading | default: 'Quick links' | escape }}">
          <p class="footer__col-head">{{ section.settings.quick_links_heading | default: 'Quick links' | escape }}</p>
          <ul class="footer__links">
            {%- if quick_count > 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'link' and block.settings.label != blank -%}
                  <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <li><a href="{{ routes.search_url }}">Search</a></li>
              {% # theme-check-disable HardcodedRoutes %}
              <li><a href="/collections/shop-all-lighting">Shop All Lighting</a></li>
              {% # theme-check-enable HardcodedRoutes %}
              <li><a href="/blogs/news">Blog</a></li>
              <li><a href="/pages/about-us">About Us</a></li>
              <li><a href="/pages/contact-us">Contact Us</a></li>
              <li><a href="/pages/reviews">Reviews</a></li>
              <li><a href="/pages/returns">Returns &amp; Refunds</a></li>
              <li><a href="https://kymra-lighting-designer-sage.vercel.app/" target="_blank" rel="noopener">Lighting Designer</a></li>
            {%- endif -%}
          </ul>
        </nav>

        {%- comment -%} Optional extra columns from linklists (skipped when empty) {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' -%}
            {%- assign fmenu = linklists[block.settings.menu] -%}
            {%- if fmenu != blank and fmenu.links.size > 0 -%}
              <nav class="footer__col" aria-label="{{ block.settings.heading | default: fmenu.title | escape }}" {{ block.shopify_attributes }}>
                <p class="footer__col-head">{{ block.settings.heading | default: fmenu.title | escape }}</p>
                <ul class="footer__links">
                  {%- for link in fmenu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'newsletter' -%}
          <div class="footer__newsletter" {{ block.shopify_attributes }}>
            <p class="eyebrow eyebrow--on-dark">{{ block.settings.eyebrow | default: 'The list' | escape }}</p>
            {%- if block.settings.heading != blank -%}<p class="footer__news-head">{{ block.settings.heading | escape }}</p>{%- endif -%}
            {%- if block.settings.body != blank -%}<p class="footer__news-body">{{ block.settings.body | escape }}</p>{%- endif -%}
            {%- form 'customer', class: 'newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label class="visually-hidden" for="footer-newsletter">{{ 'newsletter.email' | t }}</label>
              <input id="footer-newsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required autocomplete="email">
              <button type="submit" aria-label="{{ 'newsletter.subscribe' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
              {%- if form.posted_successfully? -%}
                <p class="form-note form-note--success" style="flex-basis:100%;">{{ 'newsletter.success' | t }}</p>
              {%- elsif form.errors -%}
                <p class="form-note form-note--error" style="flex-basis:100%;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ===== Social row — renders any icon that has a URL in Theme settings → Social ===== {%- endcomment -%}
    {%- liquid
      assign has_social = false
      if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_linkedin != blank or settings.social_pinterest != blank
        assign has_social = true
      endif
    -%}
    {%- if has_social -%}
      <div class="footer__social-row">
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a>
          {%- endif -%}
          {%- if settings.social_linkedin != blank -%}
            <a href="{{ settings.social_linkedin }}" aria-label="LinkedIn" rel="noopener" target="_blank">{% render 'icon', name: 'linkedin' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" rel="noopener" target="_blank">{% render 'icon', name: 'pinterest' %}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} ===== Bottom bar — copyright + address (left) · We accept + cards (right) ===== {%- endcomment -%}
    <div class="footer__bottom">
      <div class="footer__legal">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}
          {%- if section.settings.policy_menu != blank -%}
            {%- for link in linklists[section.settings.policy_menu].links -%}
              <span class="footer__dot">&middot;</span> <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </p>
        {%- if settings.registered_office != blank -%}
          <address class="footer__address">{{ settings.registered_office | escape }}</address>
        {%- endif -%}
      </div>
      {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payments">
          <span class="footer__pay-label">{{ 'general.footer.we_accept' | t }}</span>
          <div class="footer__pay-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'payment-icon' }}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Company information" },
    { "type": "checkbox", "id": "show_company", "label": "Show company information column", "default": true },
    { "type": "text", "id": "company_heading", "label": "Heading", "default": "Company information" },
    { "type": "text", "id": "company_name", "label": "Company name", "default": "Kymra Commerce LTD T/A Kymra Lighting" },
    { "type": "text", "id": "company_number", "label": "Company number", "default": "Company Number: 16970017" },
    { "type": "text", "id": "company_dpa", "label": "Data protection registration", "default": "Data Protection Registration: ZC114360" },
    { "type": "text", "id": "company_address", "label": "Registered office", "info": "The only address ever shown.", "default": "3rd Floor, 86–90 Paul Street, London EC2A 4NE" },
    { "type": "paragraph", "content": "Phone and email come from Theme settings → Contact." },
    { "type": "header", "content": "Quick links" },
    { "type": "text", "id": "quick_links_heading", "label": "Heading", "default": "Quick links" },
    { "type": "paragraph", "content": "Add \"Quick link\" blocks to control the list. Until you do, a sensible default set is shown." },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true },
    { "type": "link_list", "id": "policy_menu", "label": "Policy / legal menu", "info": "Shown in the bottom bar." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "Empty menus are skipped automatically." }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The list" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Considered new pieces and interior notes. No noise." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "label": "Search", "url": "/search" } },
      { "type": "link", "settings": { "label": "Shop All Lighting", "url": "/collections/shop-all-lighting" } },
      { "type": "link", "settings": { "label": "Blog", "url": "/blogs/news" } },
      { "type": "link", "settings": { "label": "About Us", "url": "/pages/about-us" } },
      { "type": "link", "settings": { "label": "Contact Us", "url": "/pages/contact-us" } },
      { "type": "link", "settings": { "label": "Reviews", "url": "/pages/reviews" } },
      { "type": "link", "settings": { "label": "Returns & Refunds", "url": "/pages/returns" } },
      { "type": "link", "settings": { "label": "Lighting Designer", "url": "https://kymra-lighting-designer-sage.vercel.app/" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
