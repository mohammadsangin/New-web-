{%- comment -%} Footer: brand + tagline + social · up to 3 menu columns · newsletter · payments · registered office. {%- endcomment -%}
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__brand-name">{{ section.settings.brand_name | default: shop.name | default: 'KYMRA' }}</p>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        <div class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" aria-label="Pinterest" rel="noopener" target="_blank">{% render 'icon', name: 'pinterest' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            {%- assign fmenu = linklists[block.settings.menu] -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <p class="footer__col-head">{{ block.settings.heading | default: fmenu.title | escape }}</p>
              <ul class="footer__links">
                {%- for link in fmenu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div class="footer__col footer__newsletter" {{ block.shopify_attributes }}>
              <p class="footer__news-head">{{ block.settings.heading | escape }}</p>
              {%- if block.settings.body != blank -%}<p class="footer__news-body">{{ block.settings.body | escape }}</p>{%- endif -%}
              {%- form 'customer', class: 'newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="visually-hidden" for="footer-newsletter">{{ 'newsletter.email' | t }}</label>
                <input id="footer-newsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.email_placeholder' | t }}" required autocomplete="email">
                <button type="submit" aria-label="{{ 'newsletter.subscribe' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
                {%- if form.posted_successfully? -%}
                  <p class="form-note form-note--success" style="flex-basis:100%;">{{ 'newsletter.success' | t }}</p>
                {%- elsif form.errors -%}
                  <p class="form-note form-note--error" style="flex-basis:100%;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}
        {%- if section.settings.policy_menu != blank -%}
          {%- for link in linklists[section.settings.policy_menu].links -%}
            &middot; <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </p>
      {%- if settings.registered_office != blank -%}
        <address class="footer__address">{{ settings.registered_office | escape }}</address>
      {%- endif -%}
      {%- if section.settings.show_payments and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "KYMRA" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Solid brass lighting for considered interiors. Period & Art Deco, made to order in the UK." },
    { "type": "checkbox", "id": "show_payments", "label": "Show payment icons", "default": true },
    { "type": "link_list", "id": "policy_menu", "label": "Policy / legal menu", "info": "Shown in the bottom bar." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Considered new pieces and interior notes. No noise." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
