{%- comment -%} Shop the room — dark editorial band, reversible image side. {%- endcomment -%}
<section class="editorial section">
  <div class="container">
    <div class="editorial__grid{% if section.settings.image_side == 'right' %} editorial__grid--reverse{% endif %}">
      <div class="editorial__media reveal">
        {% render 'responsive-image', image: section.settings.image, ratio: 'portrait', sizes: '(min-width: 750px) 50vw, 100vw', alt: section.settings.heading %}
      </div>
      <div class="editorial__text reveal">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="editorial__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="editorial__body">{{ section.settings.body | escape }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--on-dark" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the room",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Calm lit interior. 4:5." },
    {
      "type": "select", "id": "image_side", "label": "Image side", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the room" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Dean, at home" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Seen here in a period drawing room — solid brass, hand-finished, and quietly at ease among the details that matter." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop this look" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Shop the room" }]
}
{% endschema %}
