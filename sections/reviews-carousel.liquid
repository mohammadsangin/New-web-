{%- comment -%}
  Reviews carousel — a native, self-contained customer-reviews carousel.
  No review app, no carousel library. Each block is one review (quote, author,
  detail, 1–5 star rating, optional source label). The track uses CSS
  scroll-snap; prev/next are real <button>s with proper labels and disabled
  states at the ends. A small IIFE scoped by {{ section.id }} drives the
  buttons, dots, and optional (default-off) autoplay — independent per instance.

  Live storefront: renders nothing until reviews are added. In the theme editor
  an honest placeholder explains what to add.
{%- endcomment -%}

{%- liquid
  assign has_reviews = false
  for block in section.blocks
    if block.settings.quote != blank
      assign has_reviews = true
      break
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .reviews {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% if section.settings.background != blank %}background: {{ section.settings.background }};{% else %}background: var(--panel, #EFEADD);{% endif %}
  }
  #shopify-section-{{ section.id }} .reviews__viewport {
    position: relative;
    margin-top: clamp(28px, 4vw, 48px);
  }
  #shopify-section-{{ section.id }} .reviews__track {
    display: flex;
    gap: clamp(16px, 3vw, 28px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 4px;
  }
  #shopify-section-{{ section.id }} .reviews__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .review-card {
    scroll-snap-align: center;
    flex: 0 0 88%;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface, #FEFDFB);
    border: 1px solid var(--hairline, #DED7C7);
    border-radius: var(--radius-lg, 16px);
  }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .review-card { flex-basis: 46%; }
  }
  @media (min-width: 990px) {
    #shopify-section-{{ section.id }} .review-card--per-2 { flex-basis: 47%; }
    #shopify-section-{{ section.id }} .review-card--per-3 { flex-basis: 31%; }
  }
  #shopify-section-{{ section.id }} .review-card__stars {
    display: inline-flex;
    gap: 3px;
    color: var(--brass, #A8894F);
  }
  #shopify-section-{{ section.id }} .review-card__stars svg { width: 18px; height: 18px; display: block; }
  #shopify-section-{{ section.id }} .review-card__star--empty { color: var(--hairline, #DED7C7); }
  #shopify-section-{{ section.id }} .review-card__quote {
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(19px, 2.2vw, 25px);
    line-height: 1.4;
    color: var(--ink, #1F1D18);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .review-card__quote p { margin: 0 0 0.5em; }
  #shopify-section-{{ section.id }} .review-card__quote p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .review-card__meta { margin-top: auto; }
  #shopify-section-{{ section.id }} .review-card__author {
    font-weight: 600;
    color: var(--ink, #1F1D18);
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .review-card__detail,
  #shopify-section-{{ section.id }} .review-card__source {
    font-size: 13px;
    color: var(--muted, #6A6459);
  }
  #shopify-section-{{ section.id }} .review-card__source { margin-top: 8px; letter-spacing: 0.02em; }
  #shopify-section-{{ section.id }} .reviews__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(20px, 3vw, 32px);
  }
  #shopify-section-{{ section.id }} .reviews__arrows { display: inline-flex; gap: 10px; }
  #shopify-section-{{ section.id }} .reviews__arrow {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--hairline, #DED7C7);
    border-radius: 50%;
    background: var(--surface, #FEFDFB);
    color: var(--ink, #1F1D18);
    cursor: pointer;
    transition: border-color var(--dur-hover, 180ms) var(--ease, ease), color var(--dur-hover, 180ms) var(--ease, ease);
  }
  #shopify-section-{{ section.id }} .reviews__arrow:hover:not([disabled]) { border-color: var(--brass, #A8894F); color: var(--brass-deep, #8A6E37); }
  #shopify-section-{{ section.id }} .reviews__arrow[disabled] { opacity: 0.35; cursor: default; }
  #shopify-section-{{ section.id }} .reviews__arrow svg { width: 18px; height: 18px; }
  #shopify-section-{{ section.id }} .reviews__dots { display: inline-flex; gap: 9px; align-items: center; }
  #shopify-section-{{ section.id }} .reviews__dot {
    width: 8px; height: 8px; padding: 0;
    border: none; border-radius: 50%;
    background: var(--hairline, #DED7C7);
    cursor: pointer;
    transition: background var(--dur-hover, 180ms) var(--ease, ease), transform var(--dur-hover, 180ms) var(--ease, ease);
  }
  #shopify-section-{{ section.id }} .reviews__dot[aria-current="true"] { background: var(--brass, #A8894F); transform: scale(1.35); }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .reviews__track { scroll-behavior: auto; }
    #shopify-section-{{ section.id }} .reviews__arrow,
    #shopify-section-{{ section.id }} .reviews__dot { transition: none; }
  }
{%- endstyle -%}

{%- if has_reviews -%}
  {%- liquid
    assign card_mod = ''
    if section.settings.desktop_per_view == '2'
      assign card_mod = ' review-card--per-2'
    elsif section.settings.desktop_per_view == '3'
      assign card_mod = ' review-card--per-3'
    endif
  -%}
  <section
    class="section reviews"
    data-reviews
    data-autoplay="{% if section.settings.autoplay %}true{% else %}false{% endif %}"
    data-autoplay-speed="{{ section.settings.autoplay_speed | default: 6 }}"
    id="reviews-{{ section.id }}">
    <div class="container">
      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="section-head section-head--center reveal">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="section-head__body">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="reviews__viewport reveal">
        <div class="reviews__track" data-reviews-track tabindex="0" role="group" aria-label="Customer reviews">
          {%- for block in section.blocks -%}
            {%- if block.settings.quote != blank -%}
              {%- liquid
                assign rating = block.settings.rating | default: 5 | at_least: 1 | at_most: 5
              -%}
              <article class="review-card{{ card_mod }}" data-review-slide {{ block.shopify_attributes }}>
                <div class="review-card__stars" role="img" aria-label="Rated {{ rating }} out of 5">
                  {%- for i in (1..5) -%}
                    {%- if i <= rating -%}
                      <svg class="review-card__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.6l2.47 5.2 5.7.72-4.2 3.9 1.1 5.66L10 14.9l-5.07 2.98 1.1-5.66-4.2-3.9 5.7-.72z"/></svg>
                    {%- else -%}
                      <svg class="review-card__star review-card__star--empty" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M10 1.6l2.47 5.2 5.7.72-4.2 3.9 1.1 5.66L10 14.9l-5.07 2.98 1.1-5.66-4.2-3.9 5.7-.72z"/></svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <div class="review-card__quote">{{ block.settings.quote }}</div>
                <div class="review-card__meta">
                  {%- if block.settings.author != blank -%}
                    <div class="review-card__author">{{ block.settings.author | escape }}</div>
                  {%- endif -%}
                  {%- if block.settings.detail != blank -%}
                    <div class="review-card__detail">{{ block.settings.detail | escape }}</div>
                  {%- endif -%}
                  {%- if block.settings.source != blank -%}
                    <div class="review-card__source">{{ block.settings.source | escape }}</div>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="reviews__controls">
          <div class="reviews__dots" data-reviews-dots aria-hidden="true"></div>
          <div class="reviews__arrows">
            <button type="button" class="reviews__arrow" data-reviews-prev aria-label="Previous reviews" aria-controls="reviews-{{ section.id }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
            </button>
            <button type="button" class="reviews__arrow" data-reviews-next aria-label="Next reviews" aria-controls="reviews-{{ section.id }}">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('reviews-{{ section.id }}');
      if (!root) return;
      var track = root.querySelector('[data-reviews-track]');
      var prev = root.querySelector('[data-reviews-prev]');
      var next = root.querySelector('[data-reviews-next]');
      var dotsWrap = root.querySelector('[data-reviews-dots]');
      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-review-slide]'));
      if (!track || slides.length === 0) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function step() {
        var first = slides[0];
        var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap || '0') || 0;
        return first.getBoundingClientRect().width + gap;
      }

      function scrollToIndex(i) {
        i = Math.max(0, Math.min(i, slides.length - 1));
        track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: reduceMotion ? 'auto' : 'smooth' });
      }

      function currentIndex() {
        var pos = track.scrollLeft;
        var best = 0, bestDist = Infinity;
        for (var i = 0; i < slides.length; i++) {
          var d = Math.abs((slides[i].offsetLeft - track.offsetLeft) - pos);
          if (d < bestDist) { bestDist = d; best = i; }
        }
        return best;
      }

      // Build dots
      var dots = [];
      if (dotsWrap) {
        for (var i = 0; i < slides.length; i++) {
          var b = document.createElement('button');
          b.type = 'button';
          b.className = 'reviews__dot';
          b.setAttribute('aria-label', 'Go to review ' + (i + 1));
          (function (idx) { b.addEventListener('click', function () { scrollToIndex(idx); }); })(i);
          dotsWrap.appendChild(b);
          dots.push(b);
        }
        dotsWrap.removeAttribute('aria-hidden');
      }

      function update() {
        var idx = currentIndex();
        var atStart = track.scrollLeft <= 2;
        var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd;
        for (var i = 0; i < dots.length; i++) {
          dots[i].setAttribute('aria-current', i === idx ? 'true' : 'false');
        }
      }

      if (prev) prev.addEventListener('click', function () { scrollToIndex(currentIndex() - 1); });
      if (next) next.addEventListener('click', function () { scrollToIndex(currentIndex() + 1); });

      var scrollTimer;
      track.addEventListener('scroll', function () {
        window.clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(update, 80);
      }, { passive: true });
      window.addEventListener('resize', update);
      update();

      // Optional autoplay — default off; never under reduced motion.
      var autoplay = root.getAttribute('data-autoplay') === 'true' && !reduceMotion && slides.length > 1;
      if (autoplay) {
        var speed = (parseFloat(root.getAttribute('data-autoplay-speed')) || 6) * 1000;
        var timer = null;
        function tick() {
          var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
          scrollToIndex(atEnd ? 0 : currentIndex() + 1);
        }
        function play() { if (!timer) timer = window.setInterval(tick, speed); }
        function pause() { if (timer) { window.clearInterval(timer); timer = null; } }
        root.addEventListener('mouseenter', pause);
        root.addEventListener('mouseleave', play);
        root.addEventListener('focusin', pause);
        root.addEventListener('focusout', play);
        document.addEventListener('visibilitychange', function () { document.hidden ? pause() : play(); });
        play();
      }
    })();
  </script>
{%- elsif request.design_mode -%}
  <section class="section reviews">
    <div class="container">
      <div class="section-head section-head--center">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="section-head__title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
      <div class="section-placeholder">
        <p>Add a <strong>Review</strong> block for each testimonial — a quote and star rating at minimum. Reviews with no quote won’t appear on your live storefront.</p>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews carousel",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In their words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },
    { "type": "textarea", "id": "subheading", "label": "Subtext" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "desktop_per_view", "label": "Cards per view (desktop)", "default": "2",
      "options": [
        { "value": "1", "label": "1 (with peek)" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    { "type": "header", "content": "Autoplay" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-advance", "info": "Off by default. Pauses on hover/focus and is disabled for visitors who prefer reduced motion.", "default": false },
    { "type": "range", "id": "autoplay_speed", "min": 4, "max": 10, "step": 1, "unit": "s", "label": "Time between slides", "default": 6 },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 },
    { "type": "color", "id": "background", "label": "Background", "info": "Leave blank to use the theme’s default panel tone." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author name" },
        { "type": "text", "id": "detail", "label": "Author detail", "info": "e.g. a location or the piece they bought." },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "text", "id": "source", "label": "Source label (optional)", "info": "e.g. Verified purchase. Keep it factual." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
