         chevron-right, plus, minus, filter, truck, clock, refresh, phone,
         mail, instagram, pinterest, facebook, lightbulb, image, arrow-right,
         check, shield, star
{%- endcomment -%}
{%- liquid
  assign n = name | default: 'circle'
-%}
