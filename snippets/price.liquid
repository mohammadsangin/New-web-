{%- comment -%}
  Price display. Honest: compare-at only when a genuine compare_at_price exists.
  Params:
    product  (optional) — to show "From" for ranged products
    variant  (optional) — a specific variant; falls back to product.selected_or_first_available_variant
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant | default: product.first_available_variant
  assign price = target.price | default: product.price
  assign compare = target.compare_at_price | default: product.compare_at_price
  assign on_sale = false
  if compare and compare > price
    assign on_sale = true
  endif
  assign show_from = false
  if product and product.price_varies and variant == blank
    assign show_from = true
  endif
-%}
<span class="price{% if on_sale %} price--on-sale{% endif %}">
  {%- if show_from -%}
    <span class="price__from">{{ 'products.price.from' | t }}</span>
  {%- endif -%}
  <span class="price__regular">{{ price | money }}</span>
  {%- if on_sale -%}
    <span class="price__compare">{{ compare | money }}</span>
    <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
  {%- endif -%}
</span>
