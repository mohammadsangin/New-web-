{%- comment -%}
  Cart cross-sell cards — the scrollable list of compact product cards used by
  both the server-side fallback (in cart-drawer) and the recommendations
  section (cart-recommendations). Single source of the card markup.

  Params:
    products (required) — a product list (recommendations.products or a collection)
    cart     (required) — the cart, so items already in the bag are skipped
    limit    (optional) — max cards to show (default 8)
    heading  (optional) — used for the scroll region's aria-label
{%- endcomment -%}
{%- liquid
  assign card_limit = limit | default: 8
  assign in_cart_ids = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ','
  assign shown = 0
-%}
{%- capture cards -%}
  {%- for product in products -%}
    {%- assign needle = product.id | prepend: ',' | append: ',' -%}
    {%- if in_cart_ids contains needle or shown >= card_limit -%}{%- continue -%}{%- endif -%}
    {%- assign shown = shown | plus: 1 -%}
    {%- assign v = product.selected_or_first_available_variant -%}
    <div class="cross-card">
      <span class="cross-card__media media ratio-square">
        {%- if product.featured_media -%}
          <img src="{{ product.featured_media | image_url: width: 128 }}"
            srcset="{{ product.featured_media | image_url: width: 128 }} 1x, {{ product.featured_media | image_url: width: 256 }} 2x"
            alt="" width="64" height="64" loading="lazy" decoding="async">
        {%- else -%}
          {% render 'placeholder' %}
        {%- endif -%}
      </span>
      <span class="cross-card__info">
        <a class="cross-card__link" href="{{ product.url }}">{{ product.title }}</a>
        <span class="cross-card__price">{% render 'price', product: product %}</span>
      </span>
      {%- if product.has_only_default_variant and v and v.available -%}
        <button class="cross-card__add" type="button" data-cart-add="{{ v.id }}" aria-label="{{ 'cart.general.add_product' | t: title: product.title }}">
          {{ 'cart.general.add' | t }} {% render 'icon', name: 'plus' %}
        </button>
      {%- endif -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}
{%- if shown > 0 -%}
  <div class="cart-cross__scroll" tabindex="0" role="group" aria-label="{{ heading | default: 'You may also like' | escape }}">
    {{ cards }}
  </div>
{%- endif -%}
