    <path d="M18 42c0-9 6-18 14-18s14 9 14 18Z"/>
    <path d="M17 42h30"/>
    <path d="M27 42a5 5 0 0 0 10 0"/>
    <path d="M25 58h14M27 65h10" opacity="0.45"/>
