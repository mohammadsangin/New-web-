<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  <title>{{ page_title }} &middot; {{ shop.name }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
  {%- liquid
    assign heading_font = settings.heading_font
    assign body_font = settings.body_font
  -%}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  <style>
    {{ heading_font | font_face: font_display: 'swap' }}
    {{ body_font | font_face: font_display: 'swap' }}
    :root {
      --font-display: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
      --bg: {{ settings.color_bg }}; --surface: {{ settings.color_surface }}; --panel: {{ settings.color_panel }};
      --ink: {{ settings.color_ink }}; --muted: {{ settings.color_muted }}; --hairline: {{ settings.color_hairline }};
      --brass: {{ settings.color_brass }}; --brass-deep: {{ settings.color_brass_deep }};
      --dark: {{ settings.color_dark }}; --on-dark: {{ settings.color_on_dark }};
    }
  </style>
  {{ content_for_header }}
  <script>document.documentElement.className = 'js';</script>
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
